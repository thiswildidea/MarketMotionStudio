<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!-- Identity is replaced by the Store-assigned values at submission time.
       These placeholders are only valid for local sideload testing.

       Name and Publisher come from the name reserved in Partner Center and
       cannot be changed for that product afterwards. The DisplayName can. So
       this file carries a development placeholder until the reservation is
       made, and the reservation is the point of no return. -->
  <Identity
    Name="AShareMotionStudio.Dev"
    Publisher="CN=AShareMotionStudio-Dev"
    Version="0.1.0.0" />

  <Properties>
    <DisplayName>AShare Motion Studio</DisplayName>
    <PublisherDisplayName>AShareMotionStudio-Dev</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!-- Generated from the resources actually in the package rather than listed
       by hand. A hand-written list is a second place to remember, and the one
       that silently disagrees with Strings\ is this one: a language whose
       folder exists but whose entry is missing ships unreachable. -->
  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <!-- The description is the Store listing's first paragraph, so the
           reference-only disclaimer is in it rather than only in the app.
           A tool that draws market data has to say what it is not. -->
      <uap:VisualElements
        DisplayName="AShare Motion Studio"
        Description="Turn A-share market indicators into vertical data-visualisation videos. Animates whole-market daily turnover and a single stock's volume against its turnover rate at 9:16, and exports H.264 MP4 ready to post. For reference only; not investment advice."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <!-- Only the base names are listed. The scale and target-size variants
             beside them are matched by their filename qualifiers, including the
             unplated ones the taskbar draws: without those Windows sets the
             icon on an accent-coloured plate instead. -->
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Quote data comes over the network and nothing else does. No
         broadFileSystemAccess: the folder videos are written to is one the user
         picked through a picker, which needs no capability at all. -->
    <Capability Name="internetClient" />
    <!-- Required by every packaged Win32 desktop app. Routinely approved and
         not in the same review category as broadFileSystemAccess. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
