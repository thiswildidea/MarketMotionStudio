<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MarketMotionStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mux="using:Microsoft.UI.Xaml.Controls"
    xmlns:tray="using:H.NotifyIcon">

    <!-- Mica tints the window from the desktop behind it, which is the Windows
         way of adapting to the wallpaper: the system does the sampling, it
         updates when the wallpaper does, and it costs nothing to keep current.

         It stops at the window chrome. The preview surface draws an opaque 9:16
         frame of its own, because what the video will look like must not depend
         on the colour of the wallpaper behind the app. -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" RowDefinitions="Auto,*">

        <!-- The optional background picture and the layer that dims it, first
             so they draw beneath everything, spanning the title bar as well as
             the content. Collapsed unless a picture is chosen, so Mica shows as
             it always has. The dimming layer is the page's own base colour, so
             in either theme stronger dimming means closer to the plain window
             and never to a tint the theme does not have. The 9:16 preview draws
             an opaque frame of its own regardless — what the video will look
             like must not depend on what is behind the app. -->
        <Image x:Name="BackgroundPicture"
               Grid.RowSpan="2"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Visibility="Collapsed"
               IsHitTestVisible="False" />
        <Rectangle x:Name="BackgroundDimmer"
                   Grid.RowSpan="2"
                   Fill="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                   Visibility="Collapsed"
                   IsHitTestVisible="False" />

        <!-- Lives in the window's tree because that is where the framework can build
             it, but it outlives the window being hidden: closing the window puts it
             away rather than ending the app, and this is what brings it back. -->
        <tray:TaskbarIcon x:Name="Tray"
                          IconSource="ms-appx:///Assets/AppIcon.ico"
                          NoLeftClickDelay="True"
                          LeftClickCommand="{x:Bind ShowWindowCommand}">
            <tray:TaskbarIcon.ContextFlyout>
                <!-- Commands, not Click. The flyout is hosted by the library in its
                     own popup and a Click handler here is never reached; the item just
                     highlights and dismisses, which looks like a broken action. -->
                <MenuFlyout>
                    <MenuFlyoutItem x:Uid="TrayOpen" Command="{x:Bind ShowWindowCommand}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="TrayExit" Command="{x:Bind ExitCommand}" />
                </MenuFlyout>
            </tray:TaskbarIcon.ContextFlyout>
        </tray:TaskbarIcon>

        <!-- Draggable title bar. Drawn by hand because extending content into
             the title bar replaces the system one, which would otherwise carry
             the app's icon and name.

             Nothing is centred in it, so no column is reserved for the caption
             buttons: that reservation exists to keep a centred control centred
             on the usable width, and there is nothing here to centre. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48">
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0">
                <Image Source="ms-appx:///Assets/TitleBarLogo.png" Width="20" Height="20" />
                <TextBlock x:Name="TitleText"
                           VerticalAlignment="Center"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <!-- Auto, not Left. Left pins the pane open at every width; Auto is
             what gives the three states as the window narrows:

               wider than 1008  labels beside the icons
               641 to 1008      icons only, labels dropped
               under 641        pane hidden behind the toggle, overlaying the
                                content when opened

             The thresholds are the framework's defaults, written out because
             the behaviour is wanted by name and is worth being able to see and
             tune here rather than inferring it from an absence.

             This app has a stronger reason to keep the pane collapsible than a
             table-based one: the preview is a fixed 9:16 frame competing with a
             parameter panel for width, and on a laptop screen the navigation
             labels are the first thing worth giving up. -->
        <mux:NavigationView x:Name="Nav"
                            Grid.Row="1"
                            IsBackButtonVisible="Collapsed"
                            IsSettingsVisible="False"
                            PaneDisplayMode="Auto"
                            CompactModeThresholdWidth="641"
                            ExpandedModeThresholdWidth="1008"
                            SelectionChanged="OnNavigationSelectionChanged">

            <!-- Named because the market decides which of them are offered: a page
                 the chosen market has no data for is not listed, so the menu is
                 built once and then pared back rather than assembled per market. -->
            <mux:NavigationView.MenuItems>
                <mux:NavigationViewItem x:Name="NavMarketTurnover" x:Uid="NavMarketTurnover" Tag="MarketTurnover">
                    <mux:NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></mux:NavigationViewItem.Icon>
                </mux:NavigationViewItem>
                <mux:NavigationViewItem x:Name="NavStockVolume" x:Uid="NavStockVolume" Tag="StockVolume">
                    <mux:NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></mux:NavigationViewItem.Icon>
                </mux:NavigationViewItem>
                <mux:NavigationViewItem x:Name="NavSectorRace" x:Uid="NavSectorRace" Tag="SectorRace">
                    <mux:NavigationViewItem.Icon><FontIcon Glyph="&#xE9E9;" /></mux:NavigationViewItem.Icon>
                </mux:NavigationViewItem>
                <mux:NavigationViewItem x:Name="NavMatrix" x:Uid="NavMatrix" Tag="Matrix">
                    <mux:NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;" /></mux:NavigationViewItem.Icon>
                </mux:NavigationViewItem>
                <mux:NavigationViewItem x:Name="NavGainCalendar" x:Uid="NavGainCalendar" Tag="GainCalendar">
                    <mux:NavigationViewItem.Icon><FontIcon Glyph="&#xE787;" /></mux:NavigationViewItem.Icon>
                </mux:NavigationViewItem>
                <mux:NavigationViewItem x:Name="NavDcaPlan" x:Uid="NavDcaPlan" Tag="DcaPlan">
                    <mux:NavigationViewItem.Icon><FontIcon Glyph="&#xE8C7;" /></mux:NavigationViewItem.Icon>
                </mux:NavigationViewItem>
                <mux:NavigationViewItem x:Name="NavPosition" x:Uid="NavPosition" Tag="Position">
                    <mux:NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></mux:NavigationViewItem.Icon>
                </mux:NavigationViewItem>
            </mux:NavigationView.MenuItems>

            <mux:NavigationView.FooterMenuItems>
                <mux:NavigationViewItem x:Uid="NavHelp" Tag="Help">
                    <mux:NavigationViewItem.Icon><FontIcon Glyph="&#xE897;" /></mux:NavigationViewItem.Icon>
                </mux:NavigationViewItem>
                <!-- Content is a grid rather than the plain string the other
                     items carry, so that an update, when the Store has one,
                     can be offered on the same row. The label therefore sits on
                     a TextBlock (NavSettingsLabel.Text); a Content key here
                     would replace the grid with a string. The accessible name
                     and the compact-mode tooltip a string would have given for
                     free are set in code. -->
                <mux:NavigationViewItem x:Name="NavSettingsItem" Tag="Settings" HorizontalContentAlignment="Stretch">
                    <mux:NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></mux:NavigationViewItem.Icon>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock x:Name="NavSettingsLabel" x:Uid="NavSettingsLabel"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="UpdateButton"
                                Grid.Column="1"
                                Visibility="Collapsed"
                                Click="OnUpdate"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="8,2"
                                MinHeight="0"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE896;" FontSize="12" />
                                <TextBlock x:Name="UpdateCaption" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </mux:NavigationViewItem>
            </mux:NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </mux:NavigationView>

        <!-- Declared after the navigation view so it draws above it, and in the
             content row so it drops from under the title bar rather than over
             the draggable chrome. Parked off-screen with IsHitTestVisible off:
             a notice that cannot be interacted with must not sit invisibly in
             front of the controls it just described. -->
        <Border x:Name="Toast"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Padding="16,10"
                CornerRadius="6"
                Opacity="0"
                IsHitTestVisible="False"
                MaxWidth="560"
                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                BorderThickness="1"
                BorderBrush="{ThemeResource SystemFillColorCautionBrush}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastSlide" Y="-96" />
            </Border.RenderTransform>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE7BA;" FontSize="16"
                          VerticalAlignment="Top"
                          Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                <TextBlock x:Name="ToastText" TextWrapping="Wrap" MaxWidth="480" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
