<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MarketMotionStudio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mux="using:Microsoft.UI.Xaml.Controls"
    xmlns:tray="using:H.NotifyIcon">

    <!-- Mica tints the window from the desktop behind it, which is the Windows
         way of adapting to the wallpaper: the system does the sampling, it
         updates when the wallpaper does, and it costs nothing to keep current.

         It stops at the window chrome. The preview surface draws an opaque 9:16
         frame of its own, because what the video will look like must not depend
         on the colour of the wallpaper behind the app. -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" RowDefinitions="Auto,*">

        <!-- The optional background picture and the layer that dims it, first
             so they draw beneath everything, spanning the title bar as well as
             the content. Collapsed unless a picture is chosen, so Mica shows as
             it always has. The dimming layer is the page's own base colour, so
             in either theme stronger dimming means closer to the plain window
             and never to a tint the theme does not have. The 9:16 preview draws
             an opaque frame of its own regardless — what the video will look
             like must not depend on what is behind the app. -->
        <Image x:Name="BackgroundPicture"
               Grid.RowSpan="2"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Visibility="Collapsed"
               IsHitTestVisible="False" />
        <Rectangle x:Name="BackgroundDimmer"
                   Grid.RowSpan="2"
                   Fill="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                   Visibility="Collapsed"
                   IsHitTestVisible="False" />

        <!-- Lives in the window's tree because that is where the framework can build
             it, but it outlives the window being hidden: closing the window puts it
             away rather than ending the app, and this is what brings it back. -->
        <tray:TaskbarIcon x:Name="Tray"
                          IconSource="ms-appx:///Assets/AppIcon.ico"
                          NoLeftClickDelay="True"
                          ContextMenuMode="SecondWindow"
                          LeftClickCommand="{x:Bind ShowWindowCommand}">
            <!-- SecondWindow, not the default. The default hands the flyout to
                 the system's own Win32 menu, which carries text and nothing
                 else — every icon below would be dropped. This mode shows the
                 WinUI menu itself in a small window of its own, icons and all,
                 and it is the reason the item is reachable to automation: the
                 native menu is not. -->
            <tray:TaskbarIcon.ContextFlyout>
                <!-- Commands, not Click. The flyout is hosted by the library in its
                     own popup and a Click handler here is never reached; the item just
                     highlights and dismisses, which looks like a broken action. -->
                <MenuFlyout>
                    <MenuFlyoutItem x:Uid="TrayOpen" Command="{x:Bind ShowWindowCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <!-- "Update to …" while the Store has one, and the version
                         already installed otherwise, greyed out — there is
                         nothing to press it for. Both are set in code, since
                         the text carries the version number. -->
                    <MenuFlyoutItem x:Name="TrayUpdateItem" Command="{x:Bind UpdateCommand}" IsEnabled="False">
                        <MenuFlyoutItem.Icon>
                            <FontIcon x:Name="TrayUpdateGlyph" Glyph="&#xE895;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Uid="TrayExit" Command="{x:Bind ExitCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE7E8;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </tray:TaskbarIcon.ContextFlyout>
        </tray:TaskbarIcon>

        <!-- Draggable title bar. Drawn by hand because extending content into
             the title bar replaces the system one, which would otherwise carry
             the app's icon and name.

             Nothing is centred in it, so no column is reserved for the caption
             buttons: that reservation exists to keep a centred control centred
             on the usable width, and there is nothing here to centre.

             Back and forward move through the pages visited, as a browser
             does, rather than the pane's own back button: that one is turned
             off here, and the pane itself is hidden behind its toggle on a
             narrow window — which is also when the preview needs the width.
             The accelerators are the ones a browser answers to; the mouse's
             side buttons are handled in code. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48">
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="HistoryBackButton"
                            Click="OnHistoryBack"
                            IsEnabled="False"
                            Width="36" Height="32" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            KeyboardAcceleratorPlacementMode="Hidden">
                        <Button.KeyboardAccelerators>
                            <!-- WinUI's VirtualKey has no GoBack or GoForward, and
                                 naming one throws XamlParseException from
                                 InitializeComponent. Alt+Left is the shortcut. -->
                            <KeyboardAccelerator Modifiers="Menu" Key="Left" />
                        </Button.KeyboardAccelerators>
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    </Button>
                    <Button x:Name="HistoryForwardButton"
                            Click="OnHistoryForward"
                            IsEnabled="False"
                            Width="36" Height="32" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            KeyboardAcceleratorPlacementMode="Hidden">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Menu" Key="Right" />
                        </Button.KeyboardAccelerators>
                        <FontIcon Glyph="&#xE72A;" FontSize="14" />
                    </Button>
                </StackPanel>
                <Image Source="ms-appx:///Assets/TitleBarLogo.png" Width="20" Height="20" />
                <TextBlock x:Name="TitleText"
                           VerticalAlignment="Center"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <!-- Auto, not Left. Left pins the pane open at every width; Auto is
             what gives the three states as the window narrows:

               wider than 1008  labels beside the icons
               641 to 1008      icons only, labels dropped
               under 641        pane hidden behind the toggle, overlaying the
                                content when opened

             The thresholds are the framework's defaults, written out because
             the behaviour is wanted by name and is worth being able to see and
             tune here rather than inferring it from an absence.

             This app has a stronger reason to keep the pane collapsible than a
             table-based one: the preview is a fixed 9:16 frame competing with a
             parameter panel for width, and on a laptop screen the navigation
             labels are the first thing worth giving up. -->
        <mux:NavigationView x:Name="Nav"
                            Grid.Row="1"
                            IsBackButtonVisible="Collapsed"
                            IsSettingsVisible="False"
                            PaneDisplayMode="Auto"
                            CompactModeThresholdWidth="641"
                            ExpandedModeThresholdWidth="1008"
                            SelectionChanged="OnNavigationSelectionChanged">

            <!-- Named because the market decides which of them are offered: a page
                 the chosen market has no data for is not listed, so the menu is
                 built once and then pared back rather than assembled per market. -->
            <mux:NavigationView.MenuItems>
                <mux:NavigationViewItem x:Name="NavMarketTurnover" x:Uid="NavMarketTurnover" Tag="MarketTurnover">
                    <mux:NavigationViewItem.Icon><PathIcon Data="{StaticResource IconTurnover}" /></mux:NavigationViewItem.Icon>
                </mux:NavigationViewItem>
                <!-- Directly under the market's own turnover, because the two answer the
                     same question at two scales: the whole market's day, and one
                     instrument's day. It used to sit seventh, which put the two readings
                     of "what did today do" five items apart. -->
                <mux:NavigationViewItem x:Name="NavCandle" x:Uid="NavCandle" Tag="Candle">
                    <mux:NavigationViewItem.Icon><PathIcon Data="{StaticResource IconCandle}" /></mux:NavigationViewItem.Icon>
                </mux:NavigationViewItem>
                <mux:NavigationViewItem x:Name="NavStockVolume" x:Uid="NavStockVolume" Tag="StockVolume">
                    <mux:NavigationViewItem.Icon><PathIcon Data="{StaticResource IconVolume}" /></mux:NavigationViewItem.Icon>
                </mux:NavigationViewItem>
                <mux:NavigationViewItem x:Name="NavSectorRace" x:Uid="NavSectorRace" Tag="SectorRace">
                    <mux:NavigationViewItem.Icon><PathIcon Data="{StaticResource IconSectorRace}" /></mux:NavigationViewItem.Icon>
                </mux:NavigationViewItem>
                <!-- The race's twin, and next to it for the same reason the candle page sits
                     under the turnover page: two pages that answer one question by two measures
                     belong together. This one ranks the same way, on scale rather than on
                     return. -->
                <mux:NavigationViewItem x:Name="NavMarketCap" x:Uid="NavMarketCap" Tag="MarketCap">
                    <mux:NavigationViewItem.Icon><PathIcon Data="{StaticResource IconMarketCap}" /></mux:NavigationViewItem.Icon>
                </mux:NavigationViewItem>
                <!-- Beside the market-cap board, because both rank companies rather than days:
                     that one asks which firm is largest, this one asks which firm's mainland
                     listing costs the most more than its Hong Kong one. Two readings of one
                     market's structure, and the only page here that needs a second market to
                     mean anything at all. -->
                <mux:NavigationViewItem x:Name="NavAhPremium" x:Uid="NavAhPremium" Tag="AhPremium">
                    <mux:NavigationViewItem.Icon><PathIcon Data="{StaticResource IconAhPremium}" /></mux:NavigationViewItem.Icon>
                </mux:NavigationViewItem>
                <!-- Beside the market-cap board and the A+H page, because all three rank things
                     rather than span time: those two ask which company is largest and which is
                     dearest, this one asks which single day moved the most. The row is a day,
                     which no other page here has. -->
                <mux:NavigationViewItem x:Name="NavExtremeDays" x:Uid="NavExtremeDays" Tag="ExtremeDays">
                    <mux:NavigationViewItem.Icon><PathIcon Data="{StaticResource IconExtremeDays}" /></mux:NavigationViewItem.Icon>
                </mux:NavigationViewItem>
                <!-- Beside the extreme-day board, because both read one number against the range
                     it has lived in: that one asks how large a day was next to the largest day,
                     this one asks where a rate is between the cheapest and the dearest it has
                     been. The row is a range, which no other page here has — and unlike every
                     other board, it is not the market that decides whether it is offered. -->
                <mux:NavigationViewItem x:Name="NavFxCorridor" x:Uid="NavFxCorridor" Tag="FxCorridor">
                    <mux:NavigationViewItem.Icon><PathIcon Data="{StaticResource IconFxCorridor}" /></mux:NavigationViewItem.Icon>
                </mux:NavigationViewItem>
                <!-- Beside the A+H page and the currency corridor, because it is the third board
                     the market setting does not govern: it reads two or three markets at once,
                     so there is no single market it could be about. The row is an index, and
                     every row is measured from its own first month rather than from the board's
                     — a row joining late is absent until it joins, not sitting at zero. -->
                <mux:NavigationViewItem x:Name="NavIndexRace" x:Uid="NavIndexRace" Tag="IndexRace">
                    <mux:NavigationViewItem.Icon><PathIcon Data="{StaticResource IconIndexRace}" /></mux:NavigationViewItem.Icon>
                </mux:NavigationViewItem>
                <!-- Right after the index race, because the two are one argument seen from both
                     ends: that board races published numbers, this one races things you could
                     actually have held, and the price of holding them is invisible in the price —
                     a bond and a cash fund pay in income, a fund that split its units is a cliff
                     in its own chart. So this one is drawn from the adjusted series and that one
                     is not, which is the only respect in which they differ. -->
                <mux:NavigationViewItem x:Name="NavAssetRace" x:Uid="NavAssetRace" Tag="AssetRace">
                    <mux:NavigationViewItem.Icon><PathIcon Data="{StaticResource IconAssetRace}" /></mux:NavigationViewItem.Icon>
                </mux:NavigationViewItem>
                <mux:NavigationViewItem x:Name="NavDrawdown" x:Uid="NavDrawdown" Tag="Drawdown">
                    <mux:NavigationViewItem.Icon><PathIcon Data="{StaticResource IconDrawdown}" /></mux:NavigationViewItem.Icon>
                </mux:NavigationViewItem>
                <mux:NavigationViewItem x:Name="NavHoldOdds" x:Uid="NavHoldOdds" Tag="HoldOdds">
                    <mux:NavigationViewItem.Icon><PathIcon Data="{StaticResource IconHoldOdds}" /></mux:NavigationViewItem.Icon>
                </mux:NavigationViewItem>
                <mux:NavigationViewItem x:Name="NavMatrix" x:Uid="NavMatrix" Tag="Matrix">
                    <mux:NavigationViewItem.Icon><PathIcon Data="{StaticResource IconMatrix}" /></mux:NavigationViewItem.Icon>
                </mux:NavigationViewItem>
                <mux:NavigationViewItem x:Name="NavGainCalendar" x:Uid="NavGainCalendar" Tag="GainCalendar">
                    <mux:NavigationViewItem.Icon><PathIcon Data="{StaticResource IconGainCalendar}" /></mux:NavigationViewItem.Icon>
                </mux:NavigationViewItem>
                <mux:NavigationViewItem x:Name="NavDcaPlan" x:Uid="NavDcaPlan" Tag="DcaPlan">
                    <mux:NavigationViewItem.Icon><PathIcon Data="{StaticResource IconDcaPlan}" /></mux:NavigationViewItem.Icon>
                </mux:NavigationViewItem>
                <mux:NavigationViewItem x:Name="NavPosition" x:Uid="NavPosition" Tag="Position">
                    <mux:NavigationViewItem.Icon><PathIcon Data="{StaticResource IconPosition}" /></mux:NavigationViewItem.Icon>
                </mux:NavigationViewItem>
            </mux:NavigationView.MenuItems>

            <mux:NavigationView.FooterMenuItems>
                <mux:NavigationViewItem x:Uid="NavHelp" Tag="Help">
                    <mux:NavigationViewItem.Icon><FontIcon Glyph="&#xE897;" /></mux:NavigationViewItem.Icon>
                </mux:NavigationViewItem>
                <!-- Content is a grid rather than the plain string the other
                     items carry, so that an update, when the Store has one,
                     can be offered on the same row. The label therefore sits on
                     a TextBlock (NavSettingsLabel.Text); a Content key here
                     would replace the grid with a string. The accessible name
                     and the compact-mode tooltip a string would have given for
                     free are set in code. -->
                <mux:NavigationViewItem x:Name="NavSettingsItem" Tag="Settings" HorizontalContentAlignment="Stretch">
                    <mux:NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></mux:NavigationViewItem.Icon>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock x:Name="NavSettingsLabel" x:Uid="NavSettingsLabel"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="UpdateButton"
                                Grid.Column="1"
                                Visibility="Collapsed"
                                Click="OnUpdate"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="8,2"
                                MinHeight="0"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE896;" FontSize="12" />
                                <TextBlock x:Name="UpdateCaption" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </mux:NavigationViewItem>
            </mux:NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </mux:NavigationView>

        <!-- Declared after the navigation view so it draws above it, and in the
             content row so it drops from under the title bar rather than over
             the draggable chrome. Parked off-screen with IsHitTestVisible off:
             a notice that cannot be interacted with must not sit invisibly in
             front of the controls it just described. -->
        <Border x:Name="Toast"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Padding="16,10"
                CornerRadius="6"
                Opacity="0"
                IsHitTestVisible="False"
                MaxWidth="560"
                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                BorderThickness="1"
                BorderBrush="{ThemeResource SystemFillColorCautionBrush}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastSlide" Y="-96" />
            </Border.RenderTransform>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE7BA;" FontSize="16"
                          VerticalAlignment="Top"
                          Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                <TextBlock x:Name="ToastText" TextWrapping="Wrap" MaxWidth="480" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
