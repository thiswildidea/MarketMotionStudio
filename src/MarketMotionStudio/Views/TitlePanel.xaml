<?xml version="1.0" encoding="utf-8"?>
<!-- 每个页面标题区共享的一行：徽章 + 齿轮 + 隐藏标题开关。
     与实时持仓收益页同一个形态——徽章画「合并后」的主标题（副标题开着时下面加一行小字），
     齿轮弹出主标题/副标题两个浮动窗口，隐藏开关管画布标题显隐。本地样式逐字段覆盖全局、
     未配置回退，两层机制在 TitleStyle.Merge 里，这里只管读写与呈现。 -->
<UserControl
    x:Class="MarketMotionStudio.Views.TitlePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Border x:Name="Badge"
                    Grid.Column="0"
                    MinHeight="52"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="10,6"
                    VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="BadgeText"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontWeight="SemiBold"
                               RenderTransformOrigin="0.5,0.5" />
                    <TextBlock x:Name="BadgeSub"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontSize="11"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>
            <DropDownButton x:Name="Gear"
                            Grid.Column="1"
                            Padding="8"
                            VerticalAlignment="Center">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Uid="PortfolioPnlTitleEdit"
                                        AutomationProperties.AutomationId="EditMainTitle"
                                        Click="OnEditMainTitle" />
                        <MenuFlyoutItem x:Uid="PortfolioPnlSubtitleEdit"
                                        AutomationProperties.AutomationId="EditSubtitle"
                                        Click="OnEditSubtitle" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <ToggleSwitch x:Name="HideToggle"
                      x:Uid="StudioHideTitle"
                      Toggled="OnHideToggled" />
    </StackPanel>
</UserControl>
