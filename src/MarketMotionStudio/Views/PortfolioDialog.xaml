<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MarketMotionStudio.Views.PortfolioDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    DefaultButton="Close">

    <StackPanel Width="430" Spacing="12">

        <TextBlock x:Uid="PortfolioDialogHint"
                   TextWrapping="Wrap"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <ScrollViewer x:Name="Scroller" MaxHeight="280" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Rows" Spacing="4" />
        </ScrollViewer>

        <TextBlock x:Uid="PortfolioDialogAdd"
                   Margin="0,6,0,0"
                   Style="{StaticResource BodyStrongTextBlockStyle}" />

        <!-- One row of fields rather than a form: the whole entry is four short values, and a
             stacked form turns adding one holding into six tab stops.

             The first field suggests while the reader types — a broker's app is where the name
             comes from, and "顺丰控股" is what a person knows a stock by. It stays a free-text
             box too: a code typed and confirmed with Enter is added in one gesture. -->
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <AutoSuggestBox x:Name="CodeBox"
                            x:Uid="PortfolioDialogCode"
                            Grid.Column="0"
                            TextMemberPath="Display"
                            TextChanged="OnQueryChanged"
                            SuggestionChosen="OnSuggestionChosen"
                            QuerySubmitted="OnQuerySubmitted" />
            <TextBox x:Name="SharesBox" x:Uid="PortfolioDialogShares" Grid.Column="1" Width="96" />
            <TextBox x:Name="CostBox" x:Uid="PortfolioDialogCost" Grid.Column="2" Width="96" />
        </Grid>

        <Button x:Name="AddButton"
                x:Uid="PortfolioDialogAddButton"
                HorizontalAlignment="Stretch"
                Click="OnAdd" />

        <!-- The list as a file. A book kept in a spreadsheet is the ordinary way a reader
             reconciles with a broker, and retyping nine rows into this dialog is how the
             numbers end up differing in the fourth decimal. Export writes the columns the
             import reads, so the file is round-trippable by design. -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button x:Name="SheetImportButton"
                    x:Uid="PortfolioDialogImport"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    Click="OnImport" />
            <Button x:Name="SheetExportButton"
                    x:Uid="PortfolioDialogExport"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Click="OnExport" />
        </Grid>

        <TextBlock x:Name="Message"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Style="{StaticResource CaptionTextBlockStyle}" />
    </StackPanel>
</ContentDialog>
