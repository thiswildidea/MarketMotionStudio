<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MarketMotionStudio.Views.CryptoPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MarketMotionStudio.Controls">

    <!-- One row of switches, one per coin, a box to narrow the row with and to find coins the row
         does not hold, and a line under both saying how many are on.

         The row opens as the list of twelve (see `CryptoAsset`) — the box narrows what is shown of
         it while it is being typed. What it adds is search: what the endpoint answers appears under
         the box, and choosing one there puts it on the row as a new switch. So the twelve are read
         in one glance, and a coin that is not among them is three letters away — the same shape the
         stock pages' picker has.

         The switches are switches, not buttons that navigate: whether a coin is on the frame is a
         state, and a control that holds no state cannot be asked what is currently chosen — which
         is what a screen reader and a verification script both have to do. -->

    <StackPanel Spacing="6">
        <TextBox x:Name="Search"
                 x:Uid="CryptoSearch"
                 TextChanged="OnSearchChanged" />

        <!-- What the search answered, while it is being typed: coins that are not already switches
             on the row below. A row here is a decision to add a coin, so it is a list of choices
             and not another row of switches — pressing one adds it, it does not toggle it. -->
        <StackPanel x:Name="Found"
                    Spacing="2"
                    Visibility="Collapsed" />

        <controls:WrapPanel x:Name="Coins" />

        <!-- Only up when the box has hidden every switch. Without it the row goes blank
             and the count underneath still says three are chosen, which reads as this
             block having broken rather than as the word not being one of the twelve. -->
        <TextBlock x:Name="NoMatch"
                   x:Uid="CryptoSearchNone"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <TextBlock x:Name="Note"
                   TextWrapping="Wrap"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
</UserControl>
