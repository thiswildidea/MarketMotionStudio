<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MarketMotionStudio.Views.VideoSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One panel, used by both indicator pages. The video parameters are
         identical for the two of them, and two copies of this markup would be two
         places to remember whenever a control is added — the kind of duplication
         that is discovered only when the copies have already disagreed for a
         while. -->
    <StackPanel Spacing="14">

        <TextBlock x:Uid="StudioTitleSection" Style="{StaticResource BodyStrongTextBlockStyle}" />

        <!-- Free text, refreshing the preview as it is typed. The placeholder is set
             by the page, because what "leave it empty" means differs: the
             whole-market chart has a fixed default, the per-stock one uses whichever
             instrument was fetched.

             Enter is allowed inside it, and the box is two lines tall: the frame draws a
             title that wraps, and the one place a break cannot be asked for would be the
             control that writes it. Two lines' worth of box rather than one, so that a
             second line is visible as you type it instead of scrolling out of sight. -->
        <TextBox x:Name="TitleBox" x:Uid="StudioTitleText"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="64"
                 MaxHeight="120"
                 TextChanged="OnTitleChanged" />

        <!-- Collapsed as a group, switch and explanation together. Only the per-stock
             chart has a reason to hide its title — the name of the instrument is the
             thing someone might not want in frame — and a note left standing on the
             page without its switch would describe a control that is not there. -->
        <StackPanel x:Name="HideTitleGroup" Spacing="6" Visibility="Collapsed">
            <ToggleSwitch x:Name="HideTitleToggle" x:Uid="StudioHideTitle" Toggled="OnHideTitleToggled" />
            <TextBlock x:Uid="StudioHideTitleNote"
                       TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <TextBlock x:Uid="StudioTitleNote"
                   TextWrapping="Wrap"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <TextBlock x:Uid="StudioVideoSection"
                   Margin="0,6,0,0"
                   Style="{StaticResource BodyStrongTextBlockStyle}" />

        <StackPanel Spacing="4">
            <TextBlock x:Name="DurationLabel" Style="{StaticResource CaptionTextBlockStyle}" />
            <!-- Stepped in fives. A one-second step on a range of 170 makes the
                 slider a precision instrument for a value nobody needs to the
                 second, and the arrow keys then take 170 presses to cross it. -->
            <Slider x:Name="DurationSlider"
                    Minimum="10" Maximum="180"
                    StepFrequency="5"
                    TickFrequency="10"
                    Value="90"
                    ValueChanged="OnDurationChanged" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock x:Uid="StudioResolution" Style="{StaticResource CaptionTextBlockStyle}" />
            <ComboBox x:Name="ResolutionCombo" HorizontalAlignment="Stretch" SelectionChanged="OnFormatChanged" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock x:Uid="StudioFrameRate" Style="{StaticResource CaptionTextBlockStyle}" />
            <ComboBox x:Name="FrameRateCombo" HorizontalAlignment="Stretch" SelectionChanged="OnFormatChanged" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock x:Uid="StudioQuality" Style="{StaticResource CaptionTextBlockStyle}" />
            <ComboBox x:Name="QualityCombo" HorizontalAlignment="Stretch" SelectionChanged="OnFormatChanged" />
            <!-- The computed bit rate, shown because the three quality names do not
                 say what they cost and the number moves with the resolution and the
                 frame rate as well as with this control. -->
            <TextBlock x:Name="BitrateText"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <TextBlock x:Uid="StudioLayoutSection"
                   Margin="0,6,0,0"
                   Style="{StaticResource BodyStrongTextBlockStyle}" />

        <!-- The four margins are stated in baseline pixels against 1080x1920 and
             scaled at draw time, so a value tuned here survives a resolution
             change. The note under them says so, because otherwise the numbers
             look like they belong to whichever resolution is selected. -->
        <!-- Starting values come from ChartMargins.Default in the constructor, not from
             Value here. Both indicators share them, and a number written in markup is the
             copy that goes stale.

             The bottom slider has a different range from the side ones, and a coarser step.
             It is not symmetry with them: it has to keep a stack of content — date labels,
             four statistic cards, the credit — inside the frame, so its useful floor is far
             above zero and its ceiling is lower than a side margin's.

            The top slider runs the same way down but has a wider reach than the sides: its
            default sits on the phone's top safe area, and below that default the title is
            inside the band a status bar covers — which is a margin someone may want on a
            player that shows no chrome over the picture, and one the preview draws the band
            for. It was clamped at the safe area once, and the lower half of its range did
            nothing, which is worse than a range that is wrong: the number moved and the
            picture did not. -->
        <StackPanel Spacing="4">
            <TextBlock x:Name="MarginTopLabel" Style="{StaticResource CaptionTextBlockStyle}" />
            <Slider x:Name="MarginTopSlider" Minimum="40" Maximum="450" StepFrequency="5"
                    ValueChanged="OnMarginChanged" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock x:Name="MarginLeftLabel" Style="{StaticResource CaptionTextBlockStyle}" />
            <Slider x:Name="MarginLeftSlider" Minimum="40" Maximum="260" StepFrequency="2"
                    ValueChanged="OnMarginChanged" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock x:Name="MarginRightLabel" Style="{StaticResource CaptionTextBlockStyle}" />
            <Slider x:Name="MarginRightSlider" Minimum="40" Maximum="260" StepFrequency="2"
                    ValueChanged="OnMarginChanged" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock x:Name="MarginBottomLabel" Style="{StaticResource CaptionTextBlockStyle}" />
            <Slider x:Name="MarginBottomSlider" Minimum="150" Maximum="420" StepFrequency="5"
                    ValueChanged="OnMarginChanged" />
        </StackPanel>

        <TextBlock x:Uid="StudioMarginNote"
                   TextWrapping="Wrap"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <ToggleSwitch x:Name="GuidesToggle" x:Uid="StudioSafeArea" Toggled="OnGuidesToggled" />

        <TextBlock x:Uid="StudioSafeAreaNote"
                   TextWrapping="Wrap"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
</UserControl>
