<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MarketMotionStudio.Views.TradeImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:MarketMotionStudio.Views"
    PrimaryButtonClick="OnApply">

    <StackPanel Width="520" Spacing="10">

        <TextBlock x:Uid="PortfolioImportHint"
                   TextWrapping="Wrap"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
            <Button x:Name="SheetButton"
                    x:Uid="PortfolioImportSheet"
                    Grid.Column="0"
                    Click="OnPickSheet" />
            <DatePicker x:Name="Day"
                        x:Uid="PortfolioImportDay"
                        Grid.Column="1" />
        </Grid>

        <!-- The single source of truth for the import. A screenshot fills it in, a reader can
             correct it, and the parser reads it — so there is one path from what is on screen to
             what is applied, rather than an OCR path and a typed path that could disagree. -->
        <TextBox x:Name="Raw"
                 x:Uid="PortfolioImportRaw"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Height="150"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 TextChanged="OnRawChanged" />

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Button x:Name="ParseButton"
                    x:Uid="PortfolioImportParse"
                    Grid.Column="0"
                    Click="OnParse" />
            <TextBlock x:Name="Note"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Preview">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:ParsedRow">
                        <TextBlock Text="{x:Bind Line}"
                                   Margin="0,3"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>
</ContentDialog>
