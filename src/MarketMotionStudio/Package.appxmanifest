<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <!-- Identity is replaced by the Store-assigned values at submission time.
       These placeholders are only valid for local sideload testing.

       Name and Publisher come from the name reserved in Partner Center and
       cannot be changed for that product afterwards. The DisplayName can. So
       this file carries a development placeholder until the reservation is
       made, and the reservation is the point of no return. -->
  <Identity
    Name="8166Yxw.MarketMotionStudio"
    Publisher="CN=7092F3CD-CF1F-417D-80F4-113423DC42B8"
    Version="1.0.5.0" />

  <Properties>
    <!-- The literal name reserved in Partner Center, not a resource reference.
         The Store validates *this* element against the reservation and rejected
         "ms-resource:AppDisplayName" — it resolves the reference and finds three
         candidates (Market Motion Studio / 行情指标动画工作室 / 行情指標動畫工作室),
         none of which is reserved. Only the reserved name passes.
         The name users actually see is uap:VisualElements' DisplayName, which
         stays a resource reference: localising that one is supported. -->
    <DisplayName>MarketMotionStudio</DisplayName>
    <PublisherDisplayName>YiwenYang</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!-- Generated from the resources actually in the package rather than listed
       by hand. A hand-written list is a second place to remember, and the one
       that silently disagrees with Strings\ is this one: a language whose
       folder exists but whose entry is missing ships unreachable. -->
  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <!-- The description is the Store listing's first paragraph, so the
           reference-only disclaimer is in it rather than only in the app.
           A tool that draws market data has to say what it is not. -->
      <uap:VisualElements
        DisplayName="ms-resource:AppDisplayName"
        Description="Turn stock-market indicators into vertical data-visualisation videos for A-share, Hong Kong and US markets. Animates whole-market daily turnover and a single stock's volume against its turnover rate at 9:16, and exports H.264 MP4 ready to post. For reference only; not investment advice."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <!-- Only the base names are listed. The scale and target-size variants
             beside them are matched by their filename qualifiers, including the
             unplated ones the taskbar draws: without those Windows sets the
             icon on an accent-coloured plate instead. -->
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- Declared disabled. Windows requires the declaration to exist before
             the app may ask, but starting with Windows is the user's decision,
             not something installing this app should settle on their behalf.
             The DisplayName is what Task Manager's Startup tab shows, where the
             user can override the choice permanently. -->
        <!-- Spelled out rather than tokenised. The SDK rewrites
             $targetnametoken$ on the Application element and nowhere else, so
             inside Extensions it reached MakeAppx unchanged and failed manifest
             validation. Registering a loose folder never validates this, so it
             would only have surfaced the first time a real package was built. -->
        <uap5:Extension Category="windows.startupTask" Executable="MarketMotionStudio.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="MarketMotionStudioStartup" Enabled="false" DisplayName="ms-resource:AppDisplayName" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Quote data comes over the network and nothing else does. No
         broadFileSystemAccess: the folder videos are written to is one the user
         picked through a picker, which needs no capability at all. -->
    <Capability Name="internetClient" />
    <!-- Required by every packaged Win32 desktop app. Routinely approved and
         not in the same review category as broadFileSystemAccess. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
