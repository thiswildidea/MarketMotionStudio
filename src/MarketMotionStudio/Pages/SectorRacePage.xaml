<?xml version="1.0" encoding="utf-8"?>
<!-- Root element is the base class; see the note in MarketTurnoverPage.xaml. -->
<local:StudioPage
    x:Class="MarketMotionStudio.Pages.SectorRacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mux="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:MarketMotionStudio.Controls"
    xmlns:local="using:MarketMotionStudio.Pages"
    xmlns:views="using:MarketMotionStudio.Views"
    NavigationCacheMode="Required">

    <!-- Required, like both siblings: the roster and the parameters are worth keeping. -->

    <Grid RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0" Padding="24,20,24,12" Spacing="2">
            <TextBlock x:Uid="SectorRacePageTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Uid="SectorRacePageSubtitle"
                       TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

            <Grid Grid.Column="0" RowDefinitions="*,Auto,Auto" Margin="24,0,12,24" RowSpacing="12">

                <views:PreviewSurface x:Name="Preview" Grid.Row="0" />

                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Button x:Name="PlayButton" x:Uid="StudioPlay" Grid.Column="0" Click="OnPlay" />
                    <Slider x:Name="Scrub"
                            Grid.Column="1"
                            Minimum="0" Maximum="1"
                            StepFrequency="0.001"
                            ValueChanged="OnScrub"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="ScrubText"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               MinWidth="72"
                               TextAlignment="Right"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <mux:InfoBar x:Name="Status" Grid.Row="2" IsOpen="False" IsClosable="True" />
            </Grid>

            <ScrollViewer Grid.Column="1" Width="360" Padding="12,0,24,24">
                <StackPanel Spacing="14">

                    <TextBlock x:Uid="StudioDataSection" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <!-- The combo boxes carry their own headers (竞速对象 / 竞速指标), so no
                         standalone labels beside them — a second label over each box read as
                         two titles for one control. -->
                    <ComboBox x:Name="RosterCombo"
                              x:Uid="SectorRoster"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnRosterChanged" />

                    <!-- The custom roster's candidate grid: the two built-in lists' union. -->
                    <Grid x:Name="SectorPicker" Visibility="Collapsed">
                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SectorGrid">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:SectorPick">
                                        <CheckBox Content="{x:Bind Name}"
                                                  IsChecked="{x:Bind Picked, Mode=TwoWay}"
                                                  Tag="{x:Bind Code}"
                                                  Checked="OnPickToggled"
                                                  Unchecked="OnPickToggled"
                                                  Margin="0,0,10,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- The stock roster's search-and-add row and its chips. -->
                    <StackPanel x:Name="StockBox" Spacing="8" Visibility="Collapsed">
                        <AutoSuggestBox x:Name="StockSearch"
                                        x:Uid="StockSearch"
                                        QueryIcon="Find"
                                        TextChanged="OnSearchTextChanged"
                                        QuerySubmitted="OnSearchSubmitted"
                                        SuggestionChosen="OnSuggestionChosen" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Auto"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Hidden">
                            <ItemsControl x:Name="PickedStocks">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:RacePick">
                                        <StackPanel Orientation="Horizontal" Spacing="0">
                                            <Button Click="OnStockRemove"
                                                    Padding="10,5"
                                                    CornerRadius="10"
                                                    Tag="{x:Bind Code}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{x:Bind Name}" />
                                                    <TextBlock Text="×"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- The count with its bounds, beside the roster choice. -->
                    <TextBlock x:Name="CountText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <ComboBox x:Name="MetricCombo"
                              x:Uid="SectorMetric"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnMetricChanged" />

                    <ComboBox x:Name="RangeCombo"
                              x:Uid="StudioRange"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnRangeChanged" />

                    <!-- Shown only for the custom range. -->
                    <StackPanel x:Name="CustomRange" Spacing="8" Visibility="Collapsed">
                        <DatePicker x:Name="FromDate" x:Uid="StudioRangeFrom" HorizontalAlignment="Stretch" />
                        <DatePicker x:Name="ToDate" x:Uid="StudioRangeTo" HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <Button x:Name="FetchButton"
                            x:Uid="StudioFetch"
                            HorizontalAlignment="Stretch"
                            Click="OnFetch" />

                    <views:VideoSettingsPanel x:Name="VideoSettings" />

                    <Button x:Name="ExportButton"
                            x:Uid="StudioExport"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnExport" />

                    <!-- Saves whichever frame the preview is parked on. -->
                    <Button x:Name="CoverButton"
                            x:Uid="StudioCover"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Click="OnSaveCover" />

                    <Button x:Name="CancelButton"
                            x:Uid="StudioCancel"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Click="OnCancel" />

                    <TextBlock x:Uid="StudioDisclaimer"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</local:StudioPage>
