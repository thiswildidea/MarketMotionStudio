<?xml version="1.0" encoding="utf-8"?>
<!-- Root element is the base class; see the note in MarketTurnoverPage.xaml. -->
<local:StudioPage
    x:Class="MarketMotionStudio.Pages.PortfolioIntradayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mux="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:MarketMotionStudio.Pages"
    xmlns:views="using:MarketMotionStudio.Views"
    NavigationCacheMode="Required">

    <Grid RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0" Padding="24,20,24,12" Spacing="2">
            <TextBlock x:Uid="PortfolioPnlPageTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Uid="PortfolioPnlPageSubtitle"
                       TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

            <Grid Grid.Column="0" RowDefinitions="*,Auto,Auto" Margin="24,0,12,24" RowSpacing="12">

                <views:PreviewSurface x:Name="Preview" Grid.Row="0" />

                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Button x:Name="PlayButton"
                            Grid.Column="0"
                            Width="44"
                            Click="OnPlay">
                        <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="16" />
                    </Button>
                    <Slider x:Name="Scrub"
                            Grid.Column="1"
                            Minimum="0" Maximum="1"
                            StepFrequency="0.001"
                            ValueChanged="OnScrub"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="ScrubText"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               MinWidth="72"
                               TextAlignment="Right"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <mux:InfoBar x:Name="Status" Grid.Row="2" IsOpen="False" IsClosable="True" />
            </Grid>

            <ScrollViewer Grid.Column="1" Width="360" Padding="12,0,24,24">
                <StackPanel Spacing="14">

                    <TextBlock x:Uid="PortfolioPnlSection" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <!-- The book, read-only. It is edited in a dialog rather than inline: a
                         nine-row table of four editable fields does not fit a 360-pixel
                         column, and a mis-typed share count is a wrong video. -->
                    <Border BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            CornerRadius="6"
                            Padding="10,6">
                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="Holdings">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:HoldingRow">
                                        <Grid ColumnDefinitions="*,Auto" Padding="0,5">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{x:Bind Name}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind Detail}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind Pnl}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{x:Bind Tone}"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <TextBlock x:Name="EmptyNote"
                               x:Uid="PortfolioPnlEmpty"
                               Visibility="Collapsed"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button x:Name="ManageButton"
                                Grid.Column="0"
                                x:Uid="PortfolioPnlManage"
                                HorizontalAlignment="Stretch"
                                Click="OnManage" />
                        <Button x:Name="ImportButton"
                                Grid.Column="1"
                                x:Uid="PortfolioPnlImport"
                                HorizontalAlignment="Stretch"
                                Click="OnImport" />
                    </Grid>

                    <!-- 初值不写在标记里：这个开关的初值是**偏好**（`_prefs.GetBool("Auto", true)`），
                         `RestorePreferences` 会在构造时把它摆到位。写 `IsOn="True"` 在这里会撞上
                         `x:Uid` 那一套：带 Uid 的元素上，每个属性都会被拿去本地资源里找一遍同名键，
                         `IsOn` 找不到就报 `Failed to assign to property 'ToggleSwitch.IsOn'`，
                         整页加载失败（`SettingsWatermarkToggle` 也没有写 IsOn）。 -->
                    <ToggleSwitch x:Name="AutoRefresh"
                                  x:Uid="PortfolioPnlAutoRefresh"
                                  Toggled="OnAutoRefreshToggled" />

                    <!-- What is on the frame, in words: which day, how many minutes of it, and
                         what it came to. Kept as a line of the page rather than left in the
                         fetch's own confirmation, because a number that is redrawn every thirty
                         seconds has to be *re-read* every thirty seconds too — an import or an
                         auto-refresh that silences itself leaves a figure saying one thing above
                         a curve saying another. -->
                    <TextBlock x:Name="SummaryText"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}" />

                    <TextBlock x:Name="UpdatedText"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- Three ways of looking at the day that was fetched, all of them off by
                         default because all three are choices rather than corrections. None of
                         them reads the source again: each redraws and stops, like every other
                         look switch on every other page.

                         The rail the phone covers with its avatar and comment button is wider
                         than the default right margin, so a plot measured to the margin alone
                         runs into it; on, the picture is the width the margin asks for. -->
                    <CheckBox x:Name="CrossCheck"
                              x:Uid="SafeRightCross"
                              IsChecked="False"
                              Click="OnLookChanged" />

                    <!-- The bull or the bear on the head of the curve. The wording is the
                         per-stock page's own key: the setting is the same setting, and a second
                         key would be a second translation of one sentence. -->
                    <CheckBox x:Name="MascotCheck"
                              x:Uid="PositionMascot"
                              IsChecked="False"
                              Click="OnLookChanged" />

                    <!-- Off: the axis is the whole day's excursion from the first frame, so a
                         morning that travelled further does not rescale the afternoon. On: the
                         axis follows what has been drawn so far and lands on the whole day on
                         the closing frame, which is why a cover taken from it still matches. -->
                    <CheckBox x:Name="DynamicAxisCheck"
                              x:Uid="PositionDynamicAxis"
                              IsChecked="False"
                              Click="OnLookChanged" />

                    <!-- On: the axis is the clock, and the lunch break is a stretch of it,
                         shaded and named. Off: the ninety minutes between 11:30 and 13:00
                         come off the axis altogether, so the morning and the afternoon meet
                         where the market shut instead of being joined by an hour and a half
                         of flat line. On is what the page shipped with, and it is on by
                         default here for the same reason the other three are off: this one
                         is what the day looks like, and dropping it is the choice. -->
                    <CheckBox x:Name="LunchCheck"
                              x:Uid="PortfolioPnlLunch"
                              IsChecked="True"
                              Click="OnLookChanged" />

                    <!-- How the headline is inked, and in what colour.

                         Three treatments and one colour, in that order of consequence: the
                         colour is one choice whichever treatment is on, and the treatment is
                         three because the plain one has to stay reachable — a finish somebody
                         turned on and then could not turn off is not a setting.

                         The swatch is not decoration: the frame is on the left of this column
                         and the colour is chosen on the right, and an eighteen-pixel square is
                         the only thing on the page that says which colour is in play. It shows
                         the treatment's own default until a colour is chosen, which is what
                         makes "use the default" a visible state rather than an absence. -->
                    <ComboBox x:Name="TitleSkinCombo"
                              x:Uid="PortfolioPnlTitleSkin"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnTitleSkinChanged" />

                    <DropDownButton x:Name="TitleColourButton" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Rectangle x:Name="TitleSwatch"
                                       Width="18" Height="18"
                                       RadiusX="3" RadiusY="3"
                                       Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                       StrokeThickness="1" />
                            <TextBlock x:Uid="PortfolioPnlTitleColour" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <Flyout>
                                <StackPanel Spacing="10">
                                    <mux:ColorPicker x:Name="TitleColour"
                                                     IsAlphaEnabled="False"
                                                     ColorChanged="OnTitleColourChanged" />
                                    <Button x:Name="TitleColourDefault"
                                            x:Uid="PortfolioPnlTitleColourDefault"
                                            HorizontalAlignment="Stretch"
                                            Click="OnTitleColourDefault" />
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Button x:Name="FetchButton"
                            x:Uid="StudioFetch"
                            HorizontalAlignment="Stretch"
                            Click="OnFetch" />

                    <TextBlock x:Uid="PortfolioPnlNote"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <views:VideoSettingsPanel x:Name="VideoSettings" />

                    <Button x:Name="ExportButton"
                            x:Uid="StudioExport"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnExport" />

                    <Button x:Name="CoverButton"
                            x:Uid="StudioCover"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Click="OnSaveCover" />

                    <Button x:Name="CancelButton"
                            x:Uid="StudioCancel"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Click="OnCancel" />

                    <TextBlock x:Uid="StudioDisclaimer"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</local:StudioPage>
