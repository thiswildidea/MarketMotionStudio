<?xml version="1.0" encoding="utf-8"?>
<!-- Root element is the base class; see the note in MarketTurnoverPage.xaml. -->
<local:StudioPage
    x:Class="MarketMotionStudio.Pages.PortfolioIntradayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mux="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:MarketMotionStudio.Pages"
    xmlns:views="using:MarketMotionStudio.Views"
    NavigationCacheMode="Required">

    <Grid RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0" Padding="24,20,24,12" Spacing="2">
            <TextBlock x:Uid="PortfolioPnlPageTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Uid="PortfolioPnlPageSubtitle"
                       TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

            <Grid Grid.Column="0" RowDefinitions="*,Auto,Auto" Margin="24,0,12,24" RowSpacing="12">

                <views:PreviewSurface x:Name="Preview" Grid.Row="0" />

                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Button x:Name="PlayButton"
                            Grid.Column="0"
                            Width="44"
                            Click="OnPlay">
                        <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="16" />
                    </Button>
                    <Slider x:Name="Scrub"
                            Grid.Column="1"
                            Minimum="0" Maximum="1"
                            StepFrequency="0.001"
                            ValueChanged="OnScrub"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="ScrubText"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               MinWidth="72"
                               TextAlignment="Right"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <mux:InfoBar x:Name="Status" Grid.Row="2" IsOpen="False" IsClosable="True" />
            </Grid>

            <ScrollViewer Grid.Column="1" Width="360" Padding="12,0,24,24">
                <StackPanel Spacing="14">

                    <!-- Which book the page is reading: the mainland holdings alone, or those plus the
                         Hong Kong ones held through 港股通.

                         Two books rather than one with a filter on it, because the two cannot be drawn
                         on one axis: the Hong Kong side is priced in another currency, charged another
                         fee schedule and — having no snapshot to rebuild a past day from — can only be
                         asked about today. So the choice also decides what the page *can* answer: 港股通
                         hides the span picker above, and 近一月 is a question only the other one takes. -->
                    <ComboBox x:Name="ScopeCombo"
                              x:Uid="PortfolioPnlScope"
                              AutomationProperties.AutomationId="ScopeCombo"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnScopeChanged">
                        <ComboBoxItem x:Uid="PortfolioScopeAShare" />
                        <ComboBoxItem x:Uid="PortfolioScopeWithKong" />
                    </ComboBox>

                    <TextBlock x:Uid="PortfolioPnlSection" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <!-- Which span of days the page is answering about. The same control the
                         double-screen page binds, so both answer the same question about the
                         same book rather than two questions with one label between them. -->
                    <views:RangePicker x:Name="SpanPicker" />

                    <!-- The book, read-only. It is edited in a dialog rather than inline: a
                         nine-row table of four editable fields does not fit a 360-pixel
                         column, and a mis-typed share count is a wrong video. -->
                    <Border BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            CornerRadius="6"
                            Padding="10,6">
                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="Holdings">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:HoldingRow">
                                        <Grid ColumnDefinitions="*,Auto" Padding="0,5">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{x:Bind Name}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind Detail}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind Pnl}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{x:Bind Tone}"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <TextBlock x:Name="EmptyNote"
                               x:Uid="PortfolioPnlEmpty"
                               Visibility="Collapsed"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button x:Name="ManageButton"
                                Grid.Column="0"
                                x:Uid="PortfolioPnlManage"
                                HorizontalAlignment="Stretch"
                                Click="OnManage" />
                        <Button x:Name="ImportButton"
                                Grid.Column="1"
                                x:Uid="PortfolioPnlImport"
                                HorizontalAlignment="Stretch"
                                Click="OnImport" />
                    </Grid>

                    <!-- 初值不写在标记里：这个开关的初值是**偏好**（`_prefs.GetBool("Auto", true)`），
                         `RestorePreferences` 会在构造时把它摆到位。写 `IsOn="True"` 在这里会撞上
                         `x:Uid` 那一套：带 Uid 的元素上，每个属性都会被拿去本地资源里找一遍同名键，
                         `IsOn` 找不到就报 `Failed to assign to property 'ToggleSwitch.IsOn'`，
                         整页加载失败（`SettingsWatermarkToggle` 也没有写 IsOn）。 -->
                    <ToggleSwitch x:Name="AutoRefresh"
                                  x:Uid="PortfolioPnlAutoRefresh"
                                  Toggled="OnAutoRefreshToggled" />

                    <!-- What is on the frame, in words: which day, how many minutes of it, and
                         what it came to. Kept as a line of the page rather than left in the
                         fetch's own confirmation, because a number that is redrawn every thirty
                         seconds has to be *re-read* every thirty seconds too — an import or an
                         auto-refresh that silences itself leaves a figure saying one thing above
                         a curve saying another. -->
                    <TextBlock x:Name="SummaryText"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}" />

                    <TextBlock x:Name="UpdatedText"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- Three ways of looking at the day that was fetched, all of them off by
                         default because all three are choices rather than corrections. None of
                         them reads the source again: each redraws and stops, like every other
                         look switch on every other page.

                         The rail the phone covers with its avatar and comment button is wider
                         than the default right margin, so a plot measured to the margin alone
                         runs into it; on, the picture is the width the margin asks for. -->
                    <CheckBox x:Name="CrossCheck"
                              x:Uid="SafeRightCross"
                              IsChecked="False"
                              Click="OnLookChanged" />

                    <!-- The bull or the bear on the head of the curve. The wording is the
                         per-stock page's own key: the setting is the same setting, and a second
                         key would be a second translation of one sentence. -->
                    <CheckBox x:Name="MascotCheck"
                              x:Uid="PositionMascot"
                              IsChecked="False"
                              Click="OnLookChanged" />

                    <!-- Off: the axis is the whole day's excursion from the first frame, so a
                         morning that travelled further does not rescale the afternoon. On: the
                         axis follows what has been drawn so far and lands on the whole day on
                         the closing frame, which is why a cover taken from it still matches. -->
                    <CheckBox x:Name="DynamicAxisCheck"
                              x:Uid="PositionDynamicAxis"
                              IsChecked="False"
                              Click="OnLookChanged" />

                    <!-- On: the axis is the clock, and the lunch break is a stretch of it,
                         shaded and named. Off: the ninety minutes between 11:30 and 13:00
                         come off the axis altogether, so the morning and the afternoon meet
                         where the market shut instead of being joined by an hour and a half
                         of flat line. On is what the page shipped with, and it is on by
                         default here for the same reason the other three are off: this one
                         is what the day looks like, and dropping it is the choice. -->
                    <CheckBox x:Name="LunchCheck"
                              x:Uid="PortfolioPnlLunch"
                              IsChecked="True"
                              Click="OnLookChanged" />

                    <!-- How the headline is inked, and in what colour.

                         Three treatments and one colour, in that order of consequence: the
                         colour is one choice whichever treatment is on, and the treatment is
                         three because the plain one has to stay reachable — a finish somebody
                         turned on and then could not turn off is not a setting.

                         The swatch is not decoration: the frame is on the left of this column
                         and the colour is chosen on the right, and an eighteen-pixel square is
                         the only thing on the page that says which colour is in play. It shows
                         the treatment's own default until a colour is chosen, which is what
                         makes "use the default" a visible state rather than an absence. -->
                    <!-- What it costs to trade, which is part of what a position costs.

                         The four fields are one setting: the diluted cost a broker shows is the
                         cost of the shares *plus* what it cost to trade them, so a book that
                         leaves the fees out cannot reproduce the number the reader copied it
                         from — 中望软件's 300 remaining shares read 14.444 on the phone and
                         14.379 without the 19.60 yuan of commission and stamp duty on the two
                         sales.

                         Open with the mainland's own figures rather than zeroes, because a reader
                         who does not know them still wants the number their broker shows, and an
                         empty field that silently means "no fees" is a setting nobody can see is
                         on. Zeroing all four gets the fee-free arithmetic back.

                         Rates are in ‱ — 万2.5 is 2.5, 千0.5 is 5, 万0.1 is 0.1 — which is how a
                         statement puts them and the only unit in which all three fit on a line. -->
                    <TextBlock x:Uid="PortfolioPnlFees"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <NumberBox x:Name="FeeCommission"
                               x:Uid="PortfolioPnlFeeCommission"
                               Minimum="0" SmallChange="0.5" LargeChange="1"
                               ValueChanged="OnFeeChanged" />

                    <NumberBox x:Name="FeeMinimum"
                               x:Uid="PortfolioPnlFeeMinimum"
                               Minimum="0" SmallChange="1" LargeChange="5"
                               ValueChanged="OnFeeChanged" />

                    <NumberBox x:Name="FeeStamp"
                               x:Uid="PortfolioPnlFeeStamp"
                               Minimum="0" SmallChange="0.5" LargeChange="1"
                               ValueChanged="OnFeeChanged" />

                    <NumberBox x:Name="FeeTransfer"
                               x:Uid="PortfolioPnlFeeTransfer"
                               Minimum="0" SmallChange="0.05" LargeChange="0.1"
                               ValueChanged="OnFeeChanged" />

                    <!-- 港股通走的是另一套费：印花税双向 0.1%、交易费、证监会征费、会财局征费、
                         结算费都是法定费率，写死在代码里；佣金和最低额由券商定，所以只让读者填这两项。 -->
                    <NumberBox x:Name="FeeKongCommission"
                               x:Uid="PortfolioPnlFeeKongCommission"
                               Minimum="0" SmallChange="0.5" LargeChange="1"
                               ValueChanged="OnFeeChanged" />

                    <NumberBox x:Name="FeeKongMinimum"
                               x:Uid="PortfolioPnlFeeKongMinimum"
                               Minimum="0" SmallChange="1" LargeChange="5"
                               ValueChanged="OnFeeChanged" />

                    <!-- The headline and the gear beside it.

                         **The page used to carry a dozen controls here** — a treatment, a
                         face, a size, a spin, a wrap cap, a colour, and the same seven again
                         for the subtitle — and the column spent more height on them than on
                         the book they style. Now it carries a badge that shows what the
                         headline resolves to, and one gear that opens a dialog per subject:
                         the main title's, and the subtitle's. The choices themselves live in
                         the dialog, where a form belongs.

                         The badge is not decoration, either: with the colour and the spin
                         chosen in a dialog, it is the only thing on this side of the canvas
                         that says what is in play — the merged result, local choices over
                         the settings page's defaults, is what it shows. -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Border x:Name="TitleBadge"
                                Grid.Column="0"
                                MinHeight="52"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8"
                                Padding="10,6"
                                VerticalAlignment="Center">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="TitleBadgeText"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           FontWeight="SemiBold"
                                           RenderTransformOrigin="0.5,0.5" />
                                <TextBlock x:Name="TitleBadgeSub"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="11"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <DropDownButton x:Name="TitleGear"
                                        Grid.Column="1"
                                        Padding="8"
                                        AutomationProperties.AutomationId="TitleGear"
                                        VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Uid="PortfolioPnlTitleEdit"
                                                    AutomationProperties.AutomationId="EditMainTitle"
                                                    Click="OnEditMainTitle" />
                                    <MenuFlyoutItem x:Uid="PortfolioPnlSubtitleEdit"
                                                    AutomationProperties.AutomationId="EditSubtitle"
                                                    Click="OnEditSubtitle" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>

                    <!-- 隐藏标题：开关从视频面板挪了上来，跟在它管的东西——徽章和齿轮——
                         正下方。一个开关离它开关的东西隔着一整屏控件，读者就得到处找；
                         视频面板里的那份在本页关掉（AllowHideTitle），画的是同一个值。 -->
                    <ToggleSwitch x:Name="HideTitleToggle"
                                  x:Uid="StudioHideTitle"
                                  Toggled="OnHideTitleChanged" />

                    <Button x:Name="FetchButton"
                            x:Uid="StudioFetch"
                            HorizontalAlignment="Stretch"
                            Click="OnFetch" />

                    <TextBlock x:Uid="PortfolioPnlNote"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <views:VideoSettingsPanel x:Name="VideoSettings" />

                    <Button x:Name="ExportButton"
                            x:Uid="StudioExport"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnExport" />

                    <Button x:Name="CoverButton"
                            x:Uid="StudioCover"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Click="OnSaveCover" />

                    <Button x:Name="CancelButton"
                            x:Uid="StudioCancel"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Click="OnCancel" />

                    <TextBlock x:Uid="StudioDisclaimer"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</local:StudioPage>
