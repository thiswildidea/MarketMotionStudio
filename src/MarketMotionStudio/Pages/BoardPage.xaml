<?xml version="1.0" encoding="utf-8"?>
<!-- Root element is the base class; see the note in MarketTurnoverPage.xaml. -->
<local:StudioPage
    x:Class="MarketMotionStudio.Pages.BoardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mux="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:MarketMotionStudio.Pages"
    xmlns:views="using:MarketMotionStudio.Views"
    NavigationCacheMode="Required">

    <Grid RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0" Padding="24,20,24,12" Spacing="2">
            <TextBlock x:Uid="BoardPageTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Uid="BoardPageSubtitle"
                       TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

            <Grid Grid.Column="0" RowDefinitions="*,Auto,Auto" Margin="24,0,12,24" RowSpacing="12">

                <views:PreviewSurface x:Name="Preview" Grid.Row="0" />

                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Button x:Name="PlayButton"
                            Grid.Column="0"
                            Width="44"
                            Click="OnPlay">
                        <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="16" />
                    </Button>
                    <Slider x:Name="Scrub"
                            Grid.Column="1"
                            Minimum="0" Maximum="1"
                            StepFrequency="0.001"
                            ValueChanged="OnScrub"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="ScrubText"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               MinWidth="72"
                               TextAlignment="Right"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <mux:InfoBar x:Name="Status" Grid.Row="2" IsOpen="False" IsClosable="True" />
            </Grid>

            <ScrollViewer Grid.Column="1" Width="360" Padding="12,0,24,24">
                <StackPanel Spacing="14">

                    <!-- The same choice the per-stock page offers, and the same caption: the two
                         pages draw one book, and a reader who switched on one of them has switched
                         it for both in their own head. See PortfolioIntradayPage for what it
                         decides. Top of the rail, above the index list — it decides what the
                         whole page reads, so nothing sits before it. -->
                    <ComboBox x:Name="ScopeCombo"
                              x:Uid="PortfolioPnlScope"
                              AutomationProperties.AutomationId="ScopeCombo"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnScopeChanged">
                        <ComboBoxItem x:Uid="PortfolioScopeAShare" />
                        <ComboBoxItem x:Uid="PortfolioScopeWithKong" />
                    </ComboBox>

                    <TextBlock x:Uid="BoardSectionIndex" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <!-- Which span of days both halves of the frame are answering about. The
                         same control the returns page binds, so the two pages cannot disagree
                         about what 近一周 means — a disagreement neither would be able to show. -->
                    <views:RangePicker x:Name="SpanPicker" />

                    <!-- Two groups and not one list: the page's whole subject is that these are
                         two markets with two closing bells, and a single column of nine would
                         leave a reader guessing which line stops at three. Filled in code, from
                         the same catalog the index race page reads, so a board added there is a
                         board offered here. -->
                    <TextBlock x:Uid="BoardSectionMainland"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel x:Name="MainlandBoxes" Spacing="2" />

                    <!-- The whole group follows the 持仓范围 picker: a mainland book has no
                         Hong Kong half to read against, so under A 股 the caption and its boxes
                         go with it (ApplyScope) — the ticks themselves are kept, so switching
                         back restores them. -->
                    <TextBlock x:Name="KongHeader"
                               x:Uid="BoardSectionKong"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel x:Name="KongBoxes" Spacing="2" />

                    <TextBlock x:Uid="BoardSectionBook" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <!-- The book, read-only. It is edited on the intraday page, which owns it;
                         this page draws it, and a second editor for one file would be a second
                         way to get the same numbers wrong. -->
                    <Border BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            CornerRadius="6"
                            Padding="10,6">
                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="Holdings">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:HoldingRow">
                                        <Grid ColumnDefinitions="*,Auto" Padding="0,5">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{x:Bind Name}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind Detail}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind Pnl}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{x:Bind Tone}"
                                                       Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <TextBlock x:Name="EmptyNote"
                               x:Uid="PortfolioPnlEmpty"
                               Visibility="Collapsed"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- 同一把闸，两个页面：管理持仓与导入成交在两个页面是同一套对话框、
                         同一本 portfolio.json 账本，这里改完那边取数即最新。 -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button x:Name="ManageButton"
                                Grid.Column="0"
                                x:Uid="PortfolioPnlManage"
                                HorizontalAlignment="Stretch"
                                Click="OnManage" />
                        <Button x:Name="ImportButton"
                                Grid.Column="1"
                                x:Uid="PortfolioPnlImport"
                                HorizontalAlignment="Stretch"
                                Click="OnImport" />
                    </Grid>

                    <!-- 初值不写在标记里：这个开关的初值是**偏好**，RestorePreferences 会在
                         构造时把它摆到位（见实时持仓收益页同款开关的注）。 -->
                    <ToggleSwitch x:Name="AutoRefresh" x:Uid="BoardAutoRefresh" Toggled="OnAutoRefreshToggled" />

                    <!-- 画面开关。四个与实时持仓收益页同款（同一句翻译、同一份偏好键，
                         两页互通）；两个是本页自己的。都不重新取数，只重画。 -->
                    <CheckBox x:Name="IndexTopCheck"
                              x:Uid="BoardIndexOnTop"
                              IsChecked="False"
                              Click="OnLookChanged" />

                    <CheckBox x:Name="CrossCheck"
                              x:Uid="SafeRightCross"
                              IsChecked="False"
                              Click="OnLookChanged" />

                    <CheckBox x:Name="MascotCheck"
                              x:Uid="PositionMascot"
                              IsChecked="False"
                              Click="OnLookChanged" />

                    <CheckBox x:Name="DynamicAxisCheck"
                              x:Uid="PositionDynamicAxis"
                              IsChecked="False"
                              Click="OnLookChanged" />

                    <!-- 开：午休是一段带刻度的轴，画成阴影带（两个市场同显时只遮共用的
                         12:00–13:00）。关：午休从轴上拿掉，上午下午在 13:00 相接。 -->
                    <CheckBox x:Name="LunchCheck"
                              x:Uid="PortfolioPnlLunch"
                              IsChecked="True"
                              Click="OnLookChanged" />

                    <CheckBox x:Name="MaskCheck"
                              x:Uid="BoardMaskNames"
                              IsChecked="False"
                              Click="OnLookChanged" />

                    <!-- 费率与实时持仓收益页共用同一份偏好（Portfolio. 前缀），两页任一处
                         改动，另一页取数后即按新费率重算。 -->
                    <TextBlock x:Uid="PortfolioPnlFees"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <NumberBox x:Name="FeeCommission"
                               x:Uid="PortfolioPnlFeeCommission"
                               Minimum="0" SmallChange="0.5" LargeChange="1"
                               ValueChanged="OnFeeChanged" />

                    <NumberBox x:Name="FeeMinimum"
                               x:Uid="PortfolioPnlFeeMinimum"
                               Minimum="0" SmallChange="1" LargeChange="5"
                               ValueChanged="OnFeeChanged" />

                    <NumberBox x:Name="FeeStamp"
                               x:Uid="PortfolioPnlFeeStamp"
                               Minimum="0" SmallChange="0.5" LargeChange="1"
                               ValueChanged="OnFeeChanged" />

                    <NumberBox x:Name="FeeTransfer"
                               x:Uid="PortfolioPnlFeeTransfer"
                               Minimum="0" SmallChange="0.05" LargeChange="0.1"
                               ValueChanged="OnFeeChanged" />

                    <!-- 港股通走的是另一套费：印花税双向 0.1%、交易费、证监会征费、会财局征费、
                         结算费都是法定费率，写死在代码里；佣金和最低额由券商定，所以只让读者填这两项。 -->
                    <NumberBox x:Name="FeeKongCommission"
                               x:Uid="PortfolioPnlFeeKongCommission"
                               Minimum="0" SmallChange="0.5" LargeChange="1"
                               ValueChanged="OnFeeChanged" />

                    <NumberBox x:Name="FeeKongMinimum"
                               x:Uid="PortfolioPnlFeeKongMinimum"
                               Minimum="0" SmallChange="1" LargeChange="5"
                               ValueChanged="OnFeeChanged" />

                    <Button x:Name="FetchButton"
                            x:Uid="StudioFetch"
                            HorizontalAlignment="Stretch"
                            Click="OnFetch" />

                    <TextBlock x:Uid="BoardNote"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <TextBlock x:Name="SummaryText"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}" />

                    <TextBlock x:Name="UpdatedText"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- 标题区：徽章 + 齿轮 + 隐藏开关，与实时持仓收益页同一套。 -->
                    <views:TitlePanel x:Name="TitlePanel" />

                    <views:VideoSettingsPanel x:Name="VideoSettings" />

                    <Button x:Name="ExportButton"
                            x:Uid="StudioExport"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnExport" />

                    <Button x:Name="CoverButton"
                            x:Uid="StudioCover"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Click="OnSaveCover" />

                    <Button x:Name="CancelButton"
                            x:Uid="StudioCancel"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Click="OnCancel" />

                    <TextBlock x:Uid="StudioDisclaimer"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</local:StudioPage>
