<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MarketMotionStudio.Pages.HelpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="4" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock x:Uid="HelpPageTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Uid="HelpPageSubtitle"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <!-- Filled by the renderer at load. Empty in the markup so a document
                 that fails to open leaves a page that can say so, rather than one
                 with a heading and nothing under it. -->
            <StackPanel x:Name="Document" Spacing="0" />
        </StackPanel>
    </ScrollViewer>
</Page>
