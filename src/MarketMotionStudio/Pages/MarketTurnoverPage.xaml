<?xml version="1.0" encoding="utf-8"?>
<!-- The root element is the base class, not Page. The XAML compiler generates the
     other half of this partial class deriving from whatever the root tag names, so a
     <Page> root and a `: StudioPage` code-behind are two declarations with different
     base types and do not compile. -->
<local:StudioPage
    x:Class="MarketMotionStudio.Pages.MarketTurnoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mux="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:MarketMotionStudio.Pages"
    xmlns:views="using:MarketMotionStudio.Views"
    NavigationCacheMode="Required">

    <!-- Required, not Disabled. A page whose parameters have been tuned should be
         found as it was left: navigating to the other indicator and back is not a
         request to reset the margins and re-fetch the series. -->

    <Grid RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0" Padding="24,20,24,12" Spacing="2">
            <TextBlock x:Uid="MarketTurnoverPageTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Uid="MarketTurnoverPageSubtitle"
                       TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

            <!-- The preview takes the flexible column. It is the thing being judged
                 and it grows with the window; the parameters are a fixed-width
                 column because a wider combo box buys nothing. -->
            <Grid Grid.Column="0" RowDefinitions="*,Auto,Auto" Margin="24,0,12,24" RowSpacing="12">

                <views:PreviewSurface x:Name="Preview" Grid.Row="0" />

                <!-- Scrubbing rather than only playing. Composing a shot means
                     looking at one moment — the frame where the tallest bar lands,
                     the frame the titles finish on — and a play button can only
                     take you past it. -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <!-- Icon rather than a word. The button says which way it will move
                         the animation — ▶ to run it, ⏸ to hold it — and the shape of the
                         action is read at a glance where a label has to be read first.

                         Deliberately no x:Uid on it. A key here would set Content, and
                         Content is now the icon, so the key would swap the glyph out for
                         a string — the trap the settings item fell into. The words it
                         still needs — a tooltip, and the name a screen reader announces —
                         are set in code, because both have to follow the state. -->
                    <Button x:Name="PlayButton"
                            Grid.Column="0"
                            Width="44"
                            IsEnabled="False"
                            Click="OnPlay">
                        <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="16" />
                    </Button>
                    <Slider x:Name="Scrub"
                            Grid.Column="1"
                            Minimum="0" Maximum="1"
                            StepFrequency="0.001"
                            ValueChanged="OnScrub"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="ScrubText"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               MinWidth="72"
                               TextAlignment="Right"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <mux:InfoBar x:Name="Status" Grid.Row="2" IsOpen="False" IsClosable="True" />
            </Grid>

            <ScrollViewer Grid.Column="1" Width="360" Padding="12,0,24,24">
                <StackPanel Spacing="14">

                    <TextBlock x:Uid="StudioDataSection" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <ComboBox x:Name="RangeCombo"
                              x:Uid="StudioRange"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnRangeChanged" />

                    <!-- Shown only for the custom range. Two date pickers standing
                         permanently under a combo box that usually decides the dates
                         itself invite someone to set them and wonder why nothing
                         changed. -->
                    <StackPanel x:Name="CustomRange" Spacing="8" Visibility="Collapsed">
                        <DatePicker x:Name="FromDate" x:Uid="StudioRangeFrom" HorizontalAlignment="Stretch" />
                        <DatePicker x:Name="ToDate" x:Uid="StudioRangeTo" HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <!-- The board the series covers. Every option is the same animation on a
                         different slice of the market; the main boards are derived (an
                         exchange's composite less its growth board) because no main-board
                         composite exists on the source. -->
                    <ComboBox x:Name="ScopeCombo"
                              x:Uid="TurnoverScope"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnScopeChanged" />

                    <!-- One's own list, shown when the board menu names it. Shared with the
                         roster boards — a pick made here is on them too. Indices and stocks
                         side by side, because the amount each contributes is a sum of money
                         and the source reports it for both.

                         Selectable, unlike on the ranking boards: this is the one board that adds
                         its picks into a single number, and a total of five holdings answers no
                         question about any of them. Clicking a chip includes or drops it. -->
                    <views:WatchlistPicker x:Name="Watch"
                                           Selectable="True"
                                           Visibility="Collapsed"
                                           Changed="OnWatchChanged" />

                    <!-- Shown and hidden with the picker above, because it describes chips that
                         are not on screen otherwise. It is not in the help document: whether a
                         click adds or drops a name is not something a reader can guess from a row
                         of chips that look exactly like the ones on the ranking boards. -->
                    <TextBlock x:Uid="TurnoverPickNote"
                               x:Name="PickNote"
                               Visibility="Collapsed"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- The caveat is beside the selector, not in the help document.
                         Two of these choices change what the number means rather than how
                         it looks, and someone picking them is deciding whether a different
                         definition of "the market" is acceptable. -->
                    <TextBlock x:Uid="TurnoverScopeNote"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Button x:Name="FetchButton"
                            x:Uid="StudioFetch"
                            HorizontalAlignment="Stretch"
                            Click="OnFetch" />

                    <!-- Switchable at any time without re-fetching: both forms draw the same
                         series, so this changes the picture and not the data. Only this page has
                         it — a single stock's volume has no calendar reading worth the second
                         form. -->
                    <ComboBox x:Name="ViewCombo"
                              x:Uid="TurnoverView"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnViewChanged" />

                    <TextBlock x:Uid="TurnoverViewNote"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <views:VideoSettingsPanel x:Name="VideoSettings" />

                    <!-- Disabled until a series exists, like the cover button below it. The
                         handler returns early when there is none, so leaving it enabled is not a
                         crash — it is a click that does nothing and says nothing, which reads as
                         a broken button rather than as a step that comes later. The source tool
                         disables its play and export buttons for the same reason. -->
                    <Button x:Name="ExportButton"
                            x:Uid="StudioExport"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnExport" />

                    <!-- Saves whichever frame the preview is parked on. Useful on its own for a post
                         thumbnail, and it is the only thing here that already renders off-screen at
                         full resolution — which is the half of the encoder that can be proved early. -->
                    <Button x:Name="CoverButton"
                            x:Uid="StudioCover"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Click="OnSaveCover" />

                    <TextBlock x:Uid="StudioCoverNote"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Button x:Name="CancelButton"
                            x:Uid="StudioCancel"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Click="OnCancel" />

                    <TextBlock x:Uid="StudioDisclaimer"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</local:StudioPage>
