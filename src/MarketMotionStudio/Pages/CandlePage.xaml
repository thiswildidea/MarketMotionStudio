<?xml version="1.0" encoding="utf-8"?>
<!-- Root element is the base class; see the note in MarketTurnoverPage.xaml. -->
<local:StudioPage
    x:Class="MarketMotionStudio.Pages.CandlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mux="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:MarketMotionStudio.Controls"
    xmlns:local="using:MarketMotionStudio.Pages"
    xmlns:views="using:MarketMotionStudio.Views"
    NavigationCacheMode="Required">

    <!-- Required, not Disabled: the instrument, the period and the span are choices
         someone made once and expects to find as they left them. -->

    <Grid RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0" Padding="24,20,24,12" Spacing="2">
            <TextBlock x:Uid="CandlePageTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Uid="CandlePageSubtitle"
                       TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

            <Grid Grid.Column="0" RowDefinitions="*,Auto,Auto" Margin="24,0,12,24" RowSpacing="12">

                <views:PreviewSurface x:Name="Preview" Grid.Row="0" />

                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <!-- Icon button; see the note in MarketTurnoverPage.xaml. -->
                    <Button x:Name="PlayButton"
                            Grid.Column="0"
                            Width="44"
                            IsEnabled="False"
                            Click="OnPlay">
                        <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="16" />
                    </Button>
                    <Slider x:Name="Scrub"
                            Grid.Column="1"
                            Minimum="0" Maximum="1"
                            StepFrequency="0.001"
                            ValueChanged="OnScrub"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="ScrubText"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               MinWidth="72"
                               TextAlignment="Right"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <mux:InfoBar x:Name="Status" Grid.Row="2" IsOpen="False" IsClosable="True" />
            </Grid>

            <ScrollViewer Grid.Column="1" Width="360" Padding="12,0,24,24">
                <StackPanel Spacing="14">

                    <TextBlock x:Uid="StudioDataSection" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <!-- The same suggesting box as every page that names one instrument: a code,
                         a Chinese name or pinyin all resolve to one of them, filtered to the
                         market in force. -->
                    <AutoSuggestBox x:Name="InstrumentSearch"
                                    x:Uid="StockSearch"
                                    QueryIcon="Find"
                                    TextChanged="OnSearchTextChanged"
                                    QuerySubmitted="OnSearchSubmitted"
                                    SuggestionChosen="OnSuggestionChosen" />

                    <!-- The reader's own list, shared with the other boards that name an
                         instrument, and it sits directly under the box that fills it. The chips
                         are switches, and that is what turns one instrument's candles into a
                         comparison: pick two and the frame stops drawing candles at all,
                         because two instruments' prices have no common axis, and draws what
                         they did as percentages instead. With one pick — the state this opens
                         in — the page behaves exactly as it did before the row was here.

                         Chips only, with no search box of its own: the box above already names
                         an instrument, and naming one is what puts it on this list and draws
                         it. A second box with the same placeholder under the first is one
                         search offered twice, and nothing on screen says which of the two the
                         page is listening to. -->
                    <views:WatchlistPicker x:Name="Watch"
                                           Selectable="True"
                                           SearchVisible="False" />

                    <!-- One-tap instruments: an index, a stock and a fund from this market,
                         because the question this page is asked with is "what did it do", and
                         the three are asked about equally often.

                         Addressed by its code rather than by the name it happens to display:
                         the name is the one the interface language spells, so anything that
                         has to reach one of these — a screen reader, a script — would otherwise
                         have to know fourteen spellings. -->
                    <ItemsControl x:Name="Presets">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:MatrixPreset">
                                <Button Content="{x:Bind Name}"
                                        AutomationProperties.AutomationId="{x:Bind Code}"
                                        Tag="{x:Bind Code}"
                                        Click="OnPresetClick"
                                        Margin="0,0,8,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- The same watchlist as the other per-instrument pages, not a second one.
                         A favourite is a fact about the instrument, not about the page it was
                         added on. -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Auto"
                                  VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Hidden">
                        <ItemsControl x:Name="Favourites">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:StockFavourite">
                                    <StackPanel Orientation="Horizontal" Spacing="0">
                                        <Button Click="OnFavouriteClick"
                                                Padding="10,5"
                                                CornerRadius="10,0,0,10"
                                                Tag="{x:Bind Code}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind Name}" />
                                                <TextBlock Text="{x:Bind CodeUpper}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Click="OnFavouriteRemove"
                                                Padding="8,5"
                                                CornerRadius="0,10,10,0"
                                                Tag="{x:Bind Code}"
                                                Content="&#x2715;" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button x:Name="FavouriteButton"
                            x:Uid="StockAddFavourite"
                            HorizontalAlignment="Left"
                            Click="OnAddFavourite" />

                    <!-- What one candle covers. Changing it re-fetches: the periods are
                         different series on the source, not one series drawn differently. -->
                    <ComboBox x:Name="PeriodCombo"
                              x:Uid="CandlePeriodLabel"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnPeriodChanged" />

                    <!-- How far back, in the spans this period offers. A daily chart ten
                         years long is two and a half thousand candles; the periods do not
                         offer the same spans because they cannot draw them. A custom span
                         is the last entry on every period. -->
                    <ComboBox x:Name="RangeCombo"
                              x:Uid="StudioRange"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnRangeChanged" />

                    <!-- Shown only while the custom span is selected. Not wired to fetch on
                         every spin of a calendar: a date is picked in three clicks and each
                         one would be a request, so the span is submitted with 取数 the way
                         every other page's custom range is. -->
                    <StackPanel x:Name="CustomRange" Spacing="8" Visibility="Collapsed">
                        <DatePicker x:Name="FromDate" x:Uid="StudioRangeFrom" HorizontalAlignment="Stretch" />
                        <DatePicker x:Name="ToDate" x:Uid="StudioRangeTo" HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <!-- Which session, in place of the span, while the period is a minute
                         one. Filled from what the source came back with rather than from a
                         calendar: the minute endpoint takes no dates and keeps the last
                         few sessions, so a date picker here would offer days it cannot
                         answer. Choosing one redraws without fetching — every day on the
                         list arrived in the same request. -->
                    <ComboBox x:Name="DayCombo"
                              x:Uid="CandleDayLabel"
                              HorizontalAlignment="Stretch"
                              Visibility="Collapsed"
                              SelectionChanged="OnDayChanged" />

                    <TextBlock x:Name="DayNote"
                               x:Uid="CandleMinuteNote"
                               Visibility="Collapsed"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- How the four prices are drawn. Four ways of reading the same bars,
                         so this one re-fetches nothing. -->
                    <ComboBox x:Name="StyleCombo"
                              x:Uid="CandleStyleLabel"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnLookChanged" />

                    <!-- Whether several instruments share one axis or get a panel each.

                         A choice about the picture, like the one above it and like the motion
                         below: nothing here re-fetches. It decides how many instruments the
                         frame is *about* when they are split up, which is why the note under it
                         says how many panels there are — three curves on one axis is a
                         comparison, and a fourth instrument with no panel is a pick that was
                         silently ignored. -->
                    <ComboBox x:Name="SplitCombo"
                              x:Uid="CandleSplitLabel"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnLookChanged" />

                    <TextBlock x:Name="SplitNote"
                               x:Uid="CandleSplitNote"
                               Visibility="Collapsed"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- Whether the whole range is laid out, or a window of it walked
                         forward. The second is the only way a long range keeps a candle
                         wide enough to read. -->
                    <ComboBox x:Name="MotionCombo"
                              x:Uid="CandleMotionLabel"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnLookChanged" />

                    <!-- How many candles the window holds. Only means something while the
                         motion is scrolling, so it says so by being off otherwise. -->
                    <TextBox x:Name="WindowBox"
                             x:Uid="CandleWindowLabel"
                             Text="60"
                             TextChanged="OnLookChanged" />

                    <CheckBox x:Name="AveragesCheck"
                              x:Uid="CandleShowAverages"
                              IsChecked="True"
                              Click="OnLookChanged" />

                    <!-- Its own key, not the frame's `StockPanelVolume`: this is the
                         checkbox, that one is the panel label, and a bare key cannot
                         share a stem with a `<key>.Content` entry — MakePri reads the
                         dot as a qualifier and refuses the pair (PRI278). -->
                    <CheckBox x:Name="VolumeCheck"
                              x:Uid="CandleShowVolume"
                              IsChecked="True"
                              Click="OnLookChanged" />

                    <!-- Whether the picture may run into the band the phone's own interface
                         covers — the same switch, naming the same band, as the three boards
                         that draw a label at a line's leading end.

                         Both pictures here are answered by it. A comparison stops its curve
                         labels short of the rail, and opens out into the band at the end of a
                         scrolling run the way those three do. The candles have no label to
                         place, but the last candles are ink in the same band: off, the plot's
                         own right edge is brought in to where the rail starts, and on it runs
                         to the margin the reader set. Off by default, like everywhere else. -->
                    <CheckBox x:Name="CrossCheck"
                              x:Uid="SafeRightCross"
                              IsChecked="False"
                              Click="OnLookChanged" />

                    <Button x:Name="FetchButton"
                            x:Uid="StudioFetch"
                            HorizontalAlignment="Stretch"
                            Click="OnFetch" />

                    <views:VideoSettingsPanel x:Name="VideoSettings" />

                    <Button x:Name="ExportButton"
                            x:Uid="StudioExport"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnExport" />

                    <Button x:Name="CoverButton"
                            x:Uid="StudioCover"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Click="OnSaveCover" />

                    <TextBlock x:Uid="StudioCoverNote"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Button x:Name="CancelButton"
                            x:Uid="StudioCancel"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Click="OnCancel" />

                    <TextBlock x:Uid="StudioDisclaimer"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</local:StudioPage>
