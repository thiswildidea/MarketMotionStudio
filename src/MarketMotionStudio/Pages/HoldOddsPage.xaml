<?xml version="1.0" encoding="utf-8"?>
<!-- Root element is the base class; see the note in MarketTurnoverPage.xaml. -->
<local:StudioPage
    x:Class="MarketMotionStudio.Pages.HoldOddsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mux="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:MarketMotionStudio.Pages"
    xmlns:views="using:MarketMotionStudio.Views"
    NavigationCacheMode="Required">

    <Grid RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0" Padding="24,20,24,12" Spacing="2">
            <TextBlock x:Uid="HoldOddsPageTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Uid="HoldOddsPageSubtitle"
                       TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

            <Grid Grid.Column="0" RowDefinitions="*,Auto,Auto" Margin="24,0,12,24" RowSpacing="12">

                <views:PreviewSurface x:Name="Preview" Grid.Row="0" />

                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <!-- Icon button; see the note in MarketTurnoverPage.xaml. -->
                    <Button x:Name="PlayButton"
                            Grid.Column="0"
                            Width="44"
                            Click="OnPlay">
                        <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="16" />
                    </Button>
                    <Slider x:Name="Scrub"
                            Grid.Column="1"
                            Minimum="0" Maximum="1"
                            StepFrequency="0.001"
                            ValueChanged="OnScrub"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="ScrubText"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               MinWidth="72"
                               TextAlignment="Right"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <mux:InfoBar x:Name="Status" Grid.Row="2" IsOpen="False" IsClosable="True" />
            </Grid>

            <ScrollViewer Grid.Column="1" Width="360" Padding="12,0,24,24">
                <StackPanel Spacing="14">

                    <TextBlock x:Uid="StudioDataSection" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <!-- What a row is: not what a holding earned across the range but how often
                         walking in on an arbitrary month and holding worked. One entry is luck;
                         eighty-four of them are a rate. -->
                    <TextBlock x:Uid="HoldOddsNote"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <ComboBox x:Name="ListCombo"
                              x:Uid="AssetRaceList"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnListChanged" />

                    <!-- One's own list, shown when the menu names it. Shared with the other
                         roster boards — a pick made here is on them too — and cross-market,
                         because nothing on this page is governed by the market setting. -->
                    <views:WatchlistPicker x:Name="Watch"
                                           Visibility="Collapsed"
                                           Changed="OnWatchChanged" />

                    <ComboBox x:Name="RangeCombo"
                              x:Uid="StudioRange"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnRangeChanged" />

                    <!-- Shown only for the custom range. -->
                    <StackPanel x:Name="CustomRange" Spacing="8" Visibility="Collapsed">
                        <DatePicker x:Name="FromDate" x:Uid="StudioRangeFrom" HorizontalAlignment="Stretch" />
                        <DatePicker x:Name="ToDate" x:Uid="StudioRangeTo" HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <!-- How long each entry is held. This is the board's one new choice: the same
                         eight holdings over the same ten years answer differently for a one-year
                         hold and for a five-year one. -->
                    <ComboBox x:Name="HoldCombo"
                              x:Uid="HoldOddsHold"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnHoldChanged" />

                    <Button x:Name="FetchButton"
                            x:Uid="StudioFetch"
                            HorizontalAlignment="Stretch"
                            Click="OnFetch" />

                    <TextBlock x:Uid="HoldOddsMethodNote"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <views:VideoSettingsPanel x:Name="VideoSettings" />

                    <Button x:Name="ExportButton"
                            x:Uid="StudioExport"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnExport" />

                    <!-- Saves whichever frame the preview is parked on. -->
                    <Button x:Name="CoverButton"
                            x:Uid="StudioCover"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Click="OnSaveCover" />

                    <Button x:Name="CancelButton"
                            x:Uid="StudioCancel"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Click="OnCancel" />

                    <TextBlock x:Uid="StudioDisclaimer"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</local:StudioPage>
