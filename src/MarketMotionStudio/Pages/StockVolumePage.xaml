<?xml version="1.0" encoding="utf-8"?>
<!-- Root element is the base class; see the note in MarketTurnoverPage.xaml. -->
<local:StudioPage
    x:Class="MarketMotionStudio.Pages.StockVolumePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mux="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:MarketMotionStudio.Pages"
    xmlns:views="using:MarketMotionStudio.Views"
    NavigationCacheMode="Required">

    <!-- Required, not Disabled. This page holds a chosen stock and a watchlist as
         well as the video parameters, and re-typing a code because you looked at
         the other indicator is exactly the friction that makes a feature go
         unused. -->

    <Grid RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0" Padding="24,20,24,12" Spacing="2">
            <TextBlock x:Uid="StockVolumePageTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Uid="StockVolumePageSubtitle"
                       TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

            <Grid Grid.Column="0" RowDefinitions="*,Auto,Auto" Margin="24,0,12,24" RowSpacing="12">

                <views:PreviewSurface x:Name="Preview" Grid.Row="0" />

                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Button x:Name="PlayButton" x:Uid="StudioPlay" Grid.Column="0" Click="OnPlay" />
                    <Slider x:Name="Scrub"
                            Grid.Column="1"
                            Minimum="0" Maximum="1"
                            StepFrequency="0.001"
                            ValueChanged="OnScrub"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="ScrubText"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               MinWidth="72"
                               TextAlignment="Right"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <mux:InfoBar x:Name="Status" Grid.Row="2" IsOpen="False" IsClosable="True" />
            </Grid>

            <ScrollViewer Grid.Column="1" Width="360" Padding="12,0,24,24">
                <StackPanel Spacing="14">

                    <TextBlock x:Uid="StudioDataSection" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <!-- A suggesting box rather than a plain text field. A code is
                         six digits nobody recalls for more than a handful of names,
                         so the box takes a code, a Chinese name or pinyin and the
                         list is what turns any of the three into one instrument. -->
                    <AutoSuggestBox x:Name="StockSearch"
                                    x:Uid="StockSearch"
                                    QueryIcon="Find"
                                    TextChanged="OnSearchTextChanged"
                                    QuerySubmitted="OnSearchSubmitted"
                                    SuggestionChosen="OnSuggestionChosen" />

                    <!-- Favourites as chips: one click loads, the × forgets. Stored
                         locally with the other page state, never sent anywhere.
                         A horizontally scrolling row rather than a wrapping grid —
                         WinUI has no wrap panel without a toolkit package, and a
                         dependency for a layout this small is not worth its
                         certification weight. -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Auto"
                                  VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Hidden">
                        <ItemsControl x:Name="Favourites">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:StockFavourite">
                                    <StackPanel Orientation="Horizontal" Spacing="0">
                                        <Button Click="OnFavouriteClick"
                                                Padding="10,5"
                                                CornerRadius="10,0,0,10"
                                                Tag="{x:Bind Code}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind Name}" />
                                                <TextBlock Text="{x:Bind CodeUpper}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Click="OnFavouriteRemove"
                                                Padding="7,5"
                                                CornerRadius="0,10,10,0"
                                                Tag="{x:Bind Code}"
                                                Content="×" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button x:Name="FavouriteButton"
                            x:Uid="StockAddFavourite"
                            HorizontalAlignment="Left"
                            Click="OnAddFavourite" />

                    <!-- The chosen instrument, stated in full. A code alone does not
                         confirm that the right thing was picked; the name beside it
                         does, and this is the last chance to notice before a video
                         is rendered of the wrong company. -->
                    <TextBlock x:Name="ChosenText"
                               TextWrapping="Wrap"
                               Style="{StaticResource BodyTextBlockStyle}" />

                    <!-- Named because a market with no minute data has no choice to
                         offer: the whole group is hidden rather than leaving one
                         radio selected out of a choice of one. -->
                    <StackPanel x:Name="ModeGroup" Spacing="6">
                        <TextBlock x:Uid="StockModeLabel" Style="{StaticResource CaptionTextBlockStyle}" />
                        <!-- Two modes that are not two views of one thing. On a
                             daily chart turnover rate and volume are proportional
                             and the two panels are near-identical; within one day
                             per-minute volume and cumulative turnover have
                             genuinely different shapes. -->
                        <RadioButton x:Name="DailyMode"
                                     x:Uid="StockModeDaily"
                                     GroupName="StockMode"
                                     IsChecked="True"
                                     Checked="OnModeChanged" />
                        <RadioButton x:Name="IntradayMode"
                                     x:Uid="StockModeIntraday"
                                     GroupName="StockMode"
                                     Checked="OnModeChanged" />
                    </StackPanel>

                    <ComboBox x:Name="RangeCombo"
                              x:Uid="StudioRange"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnRangeChanged" />

                    <StackPanel x:Name="CustomRange" Spacing="8" Visibility="Collapsed">
                        <DatePicker x:Name="FromDate" x:Uid="StudioRangeFrom" HorizontalAlignment="Stretch" />
                        <DatePicker x:Name="ToDate" x:Uid="StudioRangeTo" HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <!-- Replaces the range controls in the intraday mode, where the
                         choice is one of the few days the source still holds rather
                         than an arbitrary span. -->
                    <ComboBox x:Name="TradingDayCombo"
                              x:Uid="StockTradingDay"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnTradingDayChanged"
                              Visibility="Collapsed" />

                    <TextBlock x:Uid="StockTradingDayNote"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               x:Name="TradingDayNote"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Button x:Name="FetchButton"
                            x:Uid="StudioFetch"
                            HorizontalAlignment="Stretch"
                            Click="OnFetch" />

                    <views:VideoSettingsPanel x:Name="VideoSettings" />

                    <Button x:Name="ExportButton"
                            x:Uid="StudioExport"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnExport" />

                    <!-- Saves whichever frame the preview is parked on — a post
                         thumbnail, and the reference frame every render check
                         compares an export against. -->
                    <Button x:Name="CoverButton"
                            x:Uid="StudioCover"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Click="OnSaveCover" />

                    <Button x:Name="CancelButton"
                            x:Uid="StudioCancel"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Click="OnCancel" />

                    <TextBlock x:Uid="StudioDisclaimer"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</local:StudioPage>
