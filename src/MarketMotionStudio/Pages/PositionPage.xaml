<?xml version="1.0" encoding="utf-8"?>
<!-- Root element is the base class; see the note in MarketTurnoverPage.xaml. -->
<local:StudioPage
    x:Class="MarketMotionStudio.Pages.PositionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mux="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:MarketMotionStudio.Controls"
    xmlns:local="using:MarketMotionStudio.Pages"
    xmlns:views="using:MarketMotionStudio.Views"
    NavigationCacheMode="Required">

    <!-- Required, not Disabled: a holding's instrument, capital and span are choices
         someone made once and expects to find as they left them. -->

    <Grid RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0" Padding="24,20,24,12" Spacing="2">
            <TextBlock x:Uid="PositionPageTitle" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Uid="PositionPageSubtitle"
                       TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

            <Grid Grid.Column="0" RowDefinitions="*,Auto,Auto" Margin="24,0,12,24" RowSpacing="12">

                <views:PreviewSurface x:Name="Preview" Grid.Row="0" />

                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <!-- Icon button; see the note in MarketTurnoverPage.xaml. -->
                    <Button x:Name="PlayButton"
                            Grid.Column="0"
                            Width="44"
                            IsEnabled="False"
                            Click="OnPlay">
                        <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="16" />
                    </Button>
                    <Slider x:Name="Scrub"
                            Grid.Column="1"
                            Minimum="0" Maximum="1"
                            StepFrequency="0.001"
                            ValueChanged="OnScrub"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="ScrubText"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               MinWidth="72"
                               TextAlignment="Right"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <mux:InfoBar x:Name="Status" Grid.Row="2" IsOpen="False" IsClosable="True" />
            </Grid>

            <ScrollViewer Grid.Column="1" Width="360" Padding="12,0,24,24">
                <StackPanel Spacing="14">

                    <TextBlock x:Uid="StudioDataSection" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <!-- The reader's own list, shared with every roster board rather than kept as
                         a second one here: a preference about an instrument is about the
                         instrument, not about the page it was set on. The chips are switches —
                         clicking a name decides whether that holding is on this frame — while
                         the × still takes it off the shared list everywhere. -->
                    <views:WatchlistPicker x:Name="Watch" Selectable="True" />

                    <!-- One-tap holdings: the names a long-term holding is a story about,
                         the market's own list. A press puts it on the list above and draws it —
                         one tap is the whole point of the row.

                         Addressed by its code rather than by the name it happens to display:
                         the name is the one the interface language spells, so anything that has
                         to reach one of these — a screen reader, a script — would otherwise have
                         to know fourteen spellings. -->
                    <ItemsControl x:Name="Presets">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:MatrixPreset">
                                <Button Content="{x:Bind Name}"
                                        AutomationProperties.AutomationId="{x:Bind Code}"
                                        Tag="{x:Bind Code}"
                                        Click="OnPresetClick"
                                        Margin="0,0,8,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- The holding's two terms: how much in, held since when. -->
                    <TextBox x:Name="CapitalBox"
                             x:Uid="PositionCapitalLabel"
                             Text="1000000"
                             TextChanged="OnHoldingChanged" />

                    <ComboBox x:Name="RangeCombo"
                              x:Uid="PositionRangeLabel"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnHoldingChanged" />

                    <!-- The holding's own span, two dates rather than one of the list's
                         counts. Shown by the list's choice: "since 2015" is a span no
                         count covers, and it is the question this page is asked with. -->
                    <StackPanel x:Name="CustomRange" Spacing="8" Visibility="Collapsed">
                        <DatePicker x:Name="FromDate"
                                    x:Uid="StudioRangeFrom"
                                    HorizontalAlignment="Stretch"
                                    DateChanged="OnCustomRangeChanged" />
                        <DatePicker x:Name="ToDate"
                                    x:Uid="StudioRangeTo"
                                    HorizontalAlignment="Stretch"
                                    DateChanged="OnCustomRangeChanged" />
                    </StackPanel>

                    <Button x:Name="FetchButton"
                            x:Uid="StudioFetch"
                            HorizontalAlignment="Stretch"
                            Click="OnFetch" />

                    <views:VideoSettingsPanel x:Name="VideoSettings" />

                    <Button x:Name="ExportButton"
                            x:Uid="StudioExport"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnExport" />

                    <Button x:Name="CoverButton"
                            x:Uid="StudioCover"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Click="OnSaveCover" />

                    <TextBlock x:Uid="StudioCoverNote"
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Button x:Name="CancelButton"
                            x:Uid="StudioCancel"
                            HorizontalAlignment="Stretch"
                            IsEnabled="False"
                            Click="OnCancel" />

                    <TextBlock x:Uid="StudioDisclaimer"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</local:StudioPage>
