<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MarketMotionStudio</RootNamespace>
    <AssemblyName>MarketMotionStudio</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Our own entry point, so a second launch can be folded into the running
         instance before the XAML application object exists. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <!-- The drawing surface. Win2D is the only third-party package here and it
         is Microsoft's; the encoder is Media Foundation, which is in the OS.
         Every dependency ships with the app and becomes a certification and a
         licence question at submission, so the count is kept deliberately low.

         GBK decoding for the per-stock data layer needs no package on .NET 10:
         System.Text.Encoding.CodePages ships in the box, it only has to be
         registered before use. -->
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
    <!-- The notification-area icon. The only dependency added for the tray, and a
         small one: it wraps the Win32 notify icon and hosts the context menu in
         its own popup. Version pinned to the one AgolAdminKit ships against, on
         the same net10 + WindowsAppSDK 2.5.1 stack, so the toolchain is proven. -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied, not merely included. The package registered from this output
         folder resolves its logos and its help documents by path: without the
         files beside the manifest every logo it declares is a dead reference
         and Windows silently draws a generic one instead. -->
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- Translations live in Strings\<bcp47>\Resources.resw. The SDK picks those
       up as PRIResource items on its own and MakePri reads the language from
       the folder name, so adding a language means adding a folder and nothing
       else. Declaring them here again is a duplicate-item build error. -->

</Project>
